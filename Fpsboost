HUD.BorderSizePixel = 0

HUD.Text = "FPS: --\nMS: --\n▶ TOQUE PARA PAUSAR"

HUD.TextColor3 = Color3.fromRGB(255, 255, 255)
HUD.TextSize = 16
HUD.Font = Enum.Font.GothamBold

HUD.AutoButtonColor = false

HUD.Active = true
HUD.Selectable = false

HUD.Parent = ScreenGui

--==================================================
-- CORNER
--==================================================

local Corner = Instance.new("UICorner")
Corner.CornerRadius = UDim.new(0, 14)
Corner.Parent = HUD

--==================================================
-- STROKE
--==================================================

local Stroke = Instance.new("UIStroke")
Stroke.Thickness = 1
Stroke.Transparency = 0.35
Stroke.Color = Color3.fromRGB(120, 120, 120)
Stroke.Parent = HUD

--==================================================
-- PAUSE / UNPAUSE
--==================================================

HUD.Activated:Connect(function()
    local now = os.clock()

    -- 1 toque: não faz nada
    if now - State.LastTap > Config.DoubleTapTime then
        State.LastTap = now
        return
    end

    -- 2 toques: pausa/despausa
    State.LastTap = 0
    State.Paused = not State.Paused

    if State.Paused then
        -- Mantém o GUI exatamente onde está
        HUD.Text = string.format(
            "FPS: %d\nMS: %d\n⏸ PAUSADO",
            State.FPS,
            State.MS
        )

        HUD.TextColor3 = Color3.fromRGB(255, 120, 120)

    else
        HUD.TextColor3 = Color3.fromRGB(255, 255, 255)

        HUD.Text = string.format(
            "FPS: %d\nMS: %d\n▶ ATIVO",
            State.FPS,
            State.MS
        )
    end
end)

--==================================================
-- FPS COUNTER
--==================================================

local FrameCounter = 0
local LastFPSUpdate = os.clock()

local RenderConnection

RenderConnection = RunService.RenderStepped:Connect(function()

    if State.Paused then
        return
    end

    FrameCounter += 1

    local CurrentTime = os.clock()
    local Difference = CurrentTime - LastFPSUpdate

    if Difference >= 0.5 then

        State.FPS = math.floor(FrameCounter / Difference + 0.5)

        FrameCounter = 0
        LastFPSUpdate = CurrentTime

        -- Roblox fornece o ping em segundos
        -- através de GetNetworkPing().
        local Ping = 0

        pcall(function()
            Ping = Player:GetNetworkPing() * 1000
        end)

        State.MS = math.floor(Ping + 0.5)

        HUD.Text = string.format(
            "FPS: %d\nMS: %d\n▶ TOQUE PARA PAUSAR",
            State.FPS,
            State.MS
        )
    end
end)

--==================================================
-- PERIODIC LIGHTWEIGHT CHECK
--==================================================

task.spawn(function()

    while ScreenGui.Parent do

        task.wait(5)

        if not State.Paused then

            -- Não faz uma varredura a cada frame.
            -- Isso evita que o próprio otimizador
            -- cause queda de FPS.

            ApplyGraySky()

            pcall(function()
                Lighting.GlobalShadows = false
            end)

        end
    end
end)

--==================================================
-- CLEANUP
--==================================================

ScreenGui.Destroying:Connect(function()

    if RenderConnection then
        RenderConnection:Disconnect()
    end

    if DescendantConnection then
        DescendantConnection:Disconnect()
    end

end)

