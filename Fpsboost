--==================================================
-- MOBILE PERFORMANCE OPTIMIZER
-- GRAY SKY • FPS • MS • ANTI FREEZE
--==================================================

--==================================================
-- SERVICES
--==================================================

local Players = game:GetService("Players")
local Lighting = game:GetService("Lighting")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Player = Players.LocalPlayer
local PlayerGui = Player:WaitForChild("PlayerGui")

--==================================================
-- CONFIG
--==================================================

local Config = {
    GraySky = true,
    RemoveParticles = true,
    RemoveLights = true,
    LowTextures = true,
    DisableShadows = true,
    LowMeshQuality = true,

    FPSBoost = true,
    AntiFreeze = true,
    AntiLag = true,

    DoubleTapTime = 0.30,

    -- posição do HUD
    HUD_X = 0.34,
    HUD_Y = 0.015
}

--==================================================
-- STATE
--==================================================

local State = {
    Paused = false,
    LastTap = 0,
    FPS = 0,
    MS = 0
}

--==================================================
-- GRAY SKY
--==================================================

local function ApplyGraySky()

    if not Config.GraySky then
        return
    end

    -- Remove Sky antigo
    for _, object in ipairs(Lighting:GetChildren()) do
        if object:IsA("Sky") then
            object:Destroy()
        end
    end

    local Atmosphere =
        Lighting:FindFirstChild("PerformanceGrayAtmosphere")

    if not Atmosphere then

        Atmosphere = Instance.new("Atmosphere")
        Atmosphere.Name = "PerformanceGrayAtmosphere"
        Atmosphere.Parent = Lighting

    end

    -- Cinza claro
    Atmosphere.Color =
        Color3.fromRGB(205, 205, 205)

    Atmosphere.Decay =
        Color3.fromRGB(205, 205, 205)

    -- Sem neblina
    Atmosphere.Density = 0
    Atmosphere.Haze = 0
    Atmosphere.Glare = 0
    Atmosphere.Offset = 0

    -- Iluminação
    Lighting.Ambient =
        Color3.fromRGB(205, 205, 205)

    Lighting.OutdoorAmbient =
        Color3.fromRGB(205, 205, 205)

    Lighting.Brightness = 1

end

--==================================================
-- OBJECT OPTIMIZER
--==================================================

local function OptimizeObject(object)

    if not object or not object.Parent then
        return
    end

    --------------------------------------------------
    -- PARTICLES
    --------------------------------------------------

    if Config.RemoveParticles then

        if object:IsA("ParticleEmitter")
        or object:IsA("Trail")
        or object:IsA("Beam")
        or object:IsA("Smoke")
        or object:IsA("Fire")
        or object:IsA("Sparkles") then

            pcall(function()
                object.Enabled = false
            end)

        end
    end

    --------------------------------------------------
    -- LIGHTS
    --------------------------------------------------

    if Config.RemoveLights then

        if object:IsA("PointLight")
        or object:IsA("SpotLight")
        or object:IsA("SurfaceLight") then

            pcall(function()
                object.Enabled = false
            end)

        end
    end

    --------------------------------------------------
    -- SHADOWS
    --------------------------------------------------

    if Config.DisableShadows then

        if object:IsA("BasePart") then

            pcall(function()
                object.CastShadow = false
            end)

        end

    end

    --------------------------------------------------
    -- TEXTURES
    --------------------------------------------------

    if Config.LowTextures then

        if object:IsA("Decal")
        or object:IsA("Texture") then

            pcall(function()
                object.Transparency = 1
            end)

        end

        if object:IsA("SurfaceAppearance") then

            pcall(function()
                object.Enabled = false
            end)

        end

    end

    --------------------------------------------------
    -- MESH
    --------------------------------------------------

    if Config.LowMeshQuality then

        if object:IsA("MeshPart") then

            pcall(function()

                object.RenderFidelity =
                    Enum.RenderFidelity.Performance

            end)

        end

    end

end

--==================================================
-- WORKSPACE OPTIMIZATION
--==================================================

local function OptimizeWorkspace()

    if State.Paused then
        return
    end

    for _, object in ipairs(Workspace:GetDescendants()) do

        OptimizeObject(object)

    end

end

--==================================================
-- LIGHTING OPTIMIZATION
--==================================================

local function OptimizeLighting()

    if State.Paused then
        return
    end

    pcall(function()

        Lighting.GlobalShadows = false

        Lighting.EnvironmentDiffuseScale = 0
        Lighting.EnvironmentSpecularScale = 0

    end)

end

--==================================================
-- GRAPHICS OPTIMIZATION
--==================================================

local function ApplyGraphicsOptimization()

    if not Config.FPSBoost then
        return
    end

    pcall(function()

        settings().Rendering.QualityLevel =
            Enum.QualityLevel.Level01

    end)

    pcall(function()

        Lighting.GlobalShadows = false

    end)

    -- Só funciona em ambientes que disponibilizam
    -- essa função.
    pcall(function()

        if typeof(setfpscap) == "function" then
            setfpscap(0)
        end

    end)

end

--==================================================
-- INITIALIZATION
--==================================================

ApplyGraySky()
ApplyGraphicsOptimization()
OptimizeLighting()
OptimizeWorkspace()

--==================================================
-- NEW OBJECTS
--==================================================

local ObjectConnection

ObjectConnection =
    Workspace.DescendantAdded:Connect(function(object)

        if State.Paused then
            return
        end

        task.defer(function()

            if not State.Paused then
                OptimizeObject(object)
            end

        end)

    end)

--==================================================
-- GUI
--==================================================

local OldGui =
    PlayerGui:FindFirstChild("PerformanceOptimizer")

if OldGui then
    OldGui:Destroy()
end

local ScreenGui = Instance.new("ScreenGui")

ScreenGui.Name =
    "PerformanceOptimizer"

ScreenGui.ResetOnSpawn = false
ScreenGui.IgnoreGuiInset = true
ScreenGui.ZIndexBehavior =
    Enum.ZIndexBehavior.Sibling

ScreenGui.Parent = PlayerGui

--==================================================
-- HUD
--==================================================

local HUD = Instance.new("TextButton")

HUD.Name = "PerformanceHUD"

HUD.Size =
    UDim2.fromOffset(220, 90)

HUD.Position =
    UDim2.new(
        Config.HUD_X,
        0,
        Config.HUD_Y,
        0
    )

HUD.BackgroundColor3 =
    Color3.fromRGB(35, 35, 35)

HUD.BackgroundTransparency = 0.08

HUD.BorderSizePixel = 0

HUD.Text =
    "FPS: --\nMS: --\n▶ ATIVO"

HUD.TextColor3 =
    Color3.fromRGB(255, 255, 255)

HUD.TextSize = 16
HUD.Font = Enum.Font.GothamBold

HUD.AutoButtonColor = false

HUD.Active = true
HUD.Selectable = false

-- NÃO permite arrastar
HUD.Draggable = false

HUD.Parent = ScreenGui

--==================================================
-- ROUNDED CORNER
--==================================================

local Corner = Instance.new("UICorner")

Corner.CornerRadius =
    UDim.new(0, 14)

Corner.Parent = HUD

--==================================================
-- BORDER
--==================================================

local Stroke = Instance.new("UIStroke")

Stroke.Thickness = 1
Stroke.Transparency = 0.35

Stroke.Color =
    Color3.fromRGB(120, 120, 120)

Stroke.Parent = HUD

--==================================================
-- DOUBLE TAP
--==================================================

HUD.Activated:Connect(function()

    local now = os.clock()

    --------------------------------------------------
    -- PRIMEIRO TOQUE
    --------------------------------------------------

    if now - State.LastTap >
        Config.DoubleTapTime then

        State.LastTap = now

        -- Um toque não faz nada
        return
    end

    --------------------------------------------------
    -- SEGUNDO TOQUE
    --------------------------------------------------

    State.LastTap = 0

    State.Paused =
        not State.Paused

    --------------------------------------------------
    -- PAUSADO
    --------------------------------------------------

    if State.Paused then

        HUD.Text = string.format(
            "FPS: %d\nMS: %d\n⏸ PAUSADO",
            State.FPS,
            State.MS
        )

        HUD.TextColor3 =
            Color3.fromRGB(255, 130, 130)

    --------------------------------------------------
    -- ATIVO
    --------------------------------------------------

    else

        HUD.TextColor3 =
            Color3.fromRGB(255, 255, 255)

        HUD.Text = string.format(
            "FPS: %d\nMS: %d\n▶ ATIVO",
            State.FPS,
            State.MS
        )

        task.spawn(function()

            ApplyGraySky()
            ApplyGraphicsOptimization()
            OptimizeLighting()
            OptimizeWorkspace()

        end)

    end

end)

--==================================================
-- FPS / MS MONITOR
--==================================================

local FrameCounter = 0
local LastUpdate = os.clock()

local RenderConnection

RenderConnection =
    RunService.RenderStepped:Connect(function()

        if State.Paused then
            return
        end

        FrameCounter += 1

        local now = os.clock()
        local elapsed =
            now - LastUpdate

        if elapsed >= 0.5 then

            State.FPS =
                math.floor(
                    FrameCounter / elapsed + 0.5
                )

            FrameCounter = 0
            LastUpdate = now

            --------------------------------------------------
            -- PING / MS
            --------------------------------------------------

            local Ping = 0

            pcall(function()

                Ping =
                    Player:GetNetworkPing()
                    * 1000

            end)

            State.MS =
                math.floor(Ping + 0.5)

            --------------------------------------------------
            -- HUD
            --------------------------------------------------

            HUD.Text = string.format(
                "FPS: %d\nMS: %d\n▶ ATIVO",
                State.FPS,
                State.MS
            )

        end

    end)

--==================================================
-- LIGHTWEIGHT MAINTENANCE
--==================================================

task.spawn(function()

    while ScreenGui.Parent do

        task.wait(5)

        if not State.Paused then

            -- Não executamos uma varredura
            -- a cada frame.

            ApplyGraySky()
            OptimizeLighting()

        end

    end

end)

--==================================================
-- CLEANUP
--==================================================

ScreenGui.Destroying:Connect(function()

    if RenderConnection then
        RenderConnection:Disconnect()
    end

    if ObjectConnection then
        ObjectConnection:Disconnect()
    end

end)

