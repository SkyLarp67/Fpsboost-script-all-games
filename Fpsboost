--==================================================
--        MOBILE PERFORMANCE OPTIMIZER
--        GRAY SKY • FPS • MS • ANTI FREEZE
--==================================================

--==================================================
-- SERVICES
--==================================================

local Players = game:GetService("Players")
local Lighting = game:GetService("Lighting")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local UserInputService = game:GetService("UserInputService")

local Player = Players.LocalPlayer

--==================================================
-- CONFIGURATION
--==================================================

local Config = {
    GraySky = true,
    AntiFreeze = true,
    LowTextures = true,
    RemoveLights = true,
    RemoveParticles = true,
    FPSBoost = true,
    AntiLag = true,

    GrayColor = Color3.fromRGB(205, 205, 205),

    DoubleTapTime = 0.30,

    -- Posição responsiva
    HUD_X = 0.34,
    HUD_Y = 0.015
}

--==================================================
-- STATE
--==================================================

local State = {
    Paused = false,
    LastTap = 0,
    FPS = 0,
    MS = 0
}

--==================================================
-- GRAY SKY
--==================================================

local function ApplyGraySky()

    if not Config.GraySky then
        return
    end

    -- Remove Sky antigo
    for _, object in ipairs(Lighting:GetChildren()) do
        if object:IsA("Sky") then
            object:Destroy()
        end
    end

    -- Procura Atmosphere
    local atmosphere = Lighting:FindFirstChildOfClass("Atmosphere")

    if not atmosphere then
        atmosphere = Instance.new("Atmosphere")
        atmosphere.Name = "PerformanceAtmosphere"
        atmosphere.Parent = Lighting
    end

    -- Cinza claro sem neblina
    atmosphere.Color = Config.GrayColor
    atmosphere.Decay = Config.GrayColor
    atmosphere.Glare = 0
    atmosphere.Haze = 0
    atmosphere.Density = 0
    atmosphere.Offset = 0

    -- Iluminação neutra
    Lighting.Ambient = Config.GrayColor
    Lighting.OutdoorAmbient = Config.GrayColor
    Lighting.Brightness = 1
end

--==================================================
-- REMOVE PARTICLES / EFFECTS
--==================================================

local function OptimizeEffects(object)

    if not object or not object.Parent then
        return
    end

    -- Partículas
    if Config.RemoveParticles then

        if object:IsA("ParticleEmitter") then
            object.Enabled = false

        elseif object:IsA("Trail") then
            object.Enabled = false

        elseif object:IsA("Beam") then
            object.Enabled = false

        elseif object:IsA("Smoke") then
            object.Enabled = false

        elseif object:IsA("Fire") then
            object.Enabled = false

        elseif object:IsA("Sparkles") then
            object.Enabled = false
        end
    end

    -- Luzes
    if Config.RemoveLights then

        if object:IsA("PointLight")
        or object:IsA("SpotLight")
        or object:IsA("SurfaceLight") then

            object.Enabled = false
        end
    end

    -- Sombras
    if object:IsA("BasePart") then
        pcall(function()
            object.CastShadow = false
        end)
    end

    -- Texturas
    if Config.LowTextures then

        if object:IsA("Decal")
        or object:IsA("Texture") then

            object.Transparency = 1
        end

        if object:IsA("SurfaceAppearance") then
            object.Enabled = false
        end
    end

    -- Renderização de Mesh
    if object:IsA("MeshPart") then
        pcall(function()
            object.RenderFidelity = Enum.RenderFidelity.Performance
        end)
    end
end

--==================================================
-- SCAN WORKSPACE
--==================================================

local function OptimizeWorkspace()

    if State.Paused then
        return
    end

    for _, object in ipairs(Workspace:GetDescendants()) do
        OptimizeEffects(object)
    end
end

--==================================================
-- ANTI FREEZE
--==================================================

local function ApplyAntiFreeze()

    if not Config.AntiFreeze then
        return
    end

    -- Evita algumas configurações gráficas pesadas
    pcall(function()
        settings().Rendering.QualityLevel = Enum.QualityLevel.Level01
    end)

    pcall(function()
        Lighting.GlobalShadows = false
    end)

    pcall(function()
        Lighting.EnvironmentDiffuseScale = 0
        Lighting.EnvironmentSpecularScale = 0
    end)
end

--==================================================
-- FPS BOOST
--==================================================

local function ApplyFPSBoost()

    if not Config.FPSBoost then
        return
    end

    pcall(function()
        settings().Rendering.QualityLevel = Enum.QualityLevel.Level01
    end)

    pcall(function()
        Lighting.GlobalShadows = false
    end)

    pcall(function()
        Lighting.FogEnd = 100000
    end)

    -- Remove limite de FPS somente se o ambiente
    -- disponibilizar essa função.
    pcall(function()
        if typeof(setfpscap) == "function" then
            setfpscap(0)
        end
    end)
end

--==================================================
-- ANTI LAG
--==================================================

local function ApplyAntiLag()

    if not Config.AntiLag then
        return
    end

    -- Otimiza os objetos existentes
    OptimizeWorkspace()

    -- Reforça configurações leves
    pcall(function()
        Lighting.GlobalShadows = false
        Lighting.EnvironmentDiffuseScale = 0
        Lighting.EnvironmentSpecularScale = 0
    end)
end

--==================================================
-- INITIAL OPTIMIZATION
--==================================================

ApplyGraySky()
ApplyAntiFreeze()
ApplyFPSBoost()
ApplyAntiLag()

--==================================================
-- NEW OBJECT OPTIMIZATION
--==================================================

local DescendantConnection

DescendantConnection = Workspace.DescendantAdded:Connect(function(object)

    if State.Paused then
        return
    end

    -- Pequeno atraso para objetos que ainda estão
    -- sendo montados pelo jogo.
    task.defer(function()

        if not State.Paused then
            OptimizeEffects(object)
        end

    end)
end)

--==================================================
-- GUI
--==================================================

local OldGui = Player.PlayerGui:FindFirstChild("PerformanceOptimizer")

if OldGui then
    OldGui:Destroy()
end

local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "PerformanceOptimizer"
