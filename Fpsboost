HUD.Name = "PerformanceHUD"
HUD.Size = UDim2.fromOffset(220, 90)

-- Fica um pouco deslocado para o lado,
-- mas continua responsivo.
HUD.Position = UDim2.new(
    Config.HUD_X,
    0,
