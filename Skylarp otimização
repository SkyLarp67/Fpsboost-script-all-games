    if type(data) ~= "table" then
        return
    end

    if type(data.Enabled) == "boolean" then
        SHADER_CONFIG.Enabled = data.Enabled
    end

    if type(data.LightEnabled) == "boolean" then
        SHADER_CONFIG.LightEnabled = data.LightEnabled
    end

