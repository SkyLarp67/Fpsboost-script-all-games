    statusCallback
)

    if SkyLoading then
        return false
    end

    if not skyInfo
    or not skyInfo.Id then
        return false
    end

    SkyLoading = true

    if statusCallback then

        pcall(function()

            statusCallback(
                "CARREGANDO: "
                .. skyInfo.Name
            )
        end)
    end

    local temporaryObjects = {}

    local success, result =
        pcall(function()
            return LoadSkyAsset(skyInfo.Id)
        end)

    if success and result then
        temporaryObjects = result
    end

    local sourceSky = nil

    for _, object in ipairs(temporaryObjects) do

        sourceSky = FindSky(object)

        if sourceSky then
            break
        end
    end

    if sourceSky then

        local newSky =
            Instance.new("Sky")

        newSky.Name =
            "SKYLARP_CurrentSky"

        local copied =
            CloneSkyProperties(
                sourceSky,
                newSky
            )

        if copied then

            local oldSky =
                Lighting:FindFirstChild(
                    "SKYLARP_CurrentSky"
                )

            if oldSky then
                SafeDestroy(oldSky)
            end

            local oldShader =
                Lighting:FindFirstChild(
                    "CustomSky"
                )

            if oldShader then
                SafeDestroy(oldShader)
            end

            local inserted =
                pcall(function()
                    newSky.Parent = Lighting
                end)

            if inserted
            and newSky.Parent == Lighting then

                CurrentSky = newSky
                SkySelected = skyInfo.Name

                SaveSettings()

                if statusCallback then

                    pcall(function()

                        statusCallback(
                            "ATIVO: "
                            .. skyInfo.Name
                        )
                    end)
                end

            else

                SafeDestroy(newSky)
            end

        else

            SafeDestroy(newSky)
        end

    else

        if statusCallback then

            pcall(function()

                statusCallback(
                    "ERRO: SKY NÃO ENCONTRADO"
                )
            end)
        end
    end

    for _, object in ipairs(temporaryObjects) do

        if object then
            SafeDestroy(object)
        end
    end

    SkyLoading = false

    return CurrentSky ~= nil
end

