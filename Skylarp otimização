        SetStretchFromSlider(input.Position.X)
        return
    end
    if StretchDragInput and StretchDragInput.UserInputType == Enum.UserInputType.MouseButton1 then
        if input.UserInputType == Enum.UserInputType.MouseMovement then SetStretchFromSlider(input.Position.X) end
