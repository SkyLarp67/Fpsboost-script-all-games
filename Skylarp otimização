local PerformanceConnections = {}
local CharacterConnections = {}

local function DisconnectConnection(
    connection
)

    if connection then

        pcall(function()

            connection:Disconnect()

        end)

    end
end

local function DisconnectList(list)

    for key, connection in pairs(list) do

        DisconnectConnection(
            connection
        )

        list[key] = nil

    end
end

local function IsCharacterPart(object)

    if not object then
        return false
    end

    local model =
        object:FindFirstAncestorOfClass(
            "Model"
        )

    if not model then
        return false
    end

    return Players:GetPlayerFromCharacter(
        model
    ) ~= nil
end

local function ApplyNoCameraEffects()

    if not CONFIG.Performance.NoCameraEffects then
        return
    end

    pcall(function()

        for _, object in ipairs(
            Lighting:GetChildren()
        ) do

            if object:IsA("PostEffect") then

                SafeDestroy(object)

            end

        end

    end)
end

local function ApplyNoClothes(object)

    if not CONFIG.Performance.NoClothes then
        return
    end

    if not object then
        return
    end

    pcall(function()

        if object:IsA("Shirt")
            or object:IsA("Pants")
            or object:IsA("ShirtGraphic")
            or object:IsA("CharacterMesh") then

            SafeDestroy(object)

            return
        end

        if object:IsA("Accessory")
            and IsCharacterPart(object) then

            SafeDestroy(object)

        end

    end)
end

local function ApplyLowWater(object)

    if not CONFIG.Performance.LowWaterGraphics then
        return
    end

    if not object then
        return
    end

    pcall(function()

        if object:IsA("Terrain") then

            SafeSet(
                object,
                "WaterWaveSize",
                0
            )

            SafeSet(
                object,
                "WaterWaveSpeed",
                0
            )

            SafeSet(
                object,
                "WaterReflectance",
                0
            )

            SafeSet(
                object,
                "WaterTransparency",
                1
            )

        end

    end)
end

local function ApplyNoShadows(object)

    if not CONFIG.Performance.NoShadows then
        return
    end

    if not object then
        return
    end

    pcall(function()

        if object:IsA("BasePart") then

            SafeSet(
                object,
                "CastShadow",
                false
            )

        end

    end)
end

local function ApplyLowRendering()

    if not CONFIG.Performance.LowRendering then
        return
    end

    pcall(function()

        settings().Rendering.QualityLevel =
            Enum.QualityLevel.Level01

    end)

    pcall(function()

        Lighting.GlobalShadows =
            false

    end)
end

local function ApplyLowQualityParts(object)

    if not CONFIG.Performance.LowQualityParts then
        return
    end

    if not object then
        return
    end

    pcall(function()

        if object:IsA("BasePart") then

            SafeSet(
                object,
                "Reflectance",
                0
            )

            SafeSet(
                object,
                "Material",
                Enum.Material.SmoothPlastic
            )

            if object:IsA("MeshPart") then

                SafeSet(
                    object,
                    "RenderFidelity",
                    Enum.RenderFidelity.Performance
                )

            end

        end

    end)
end

local function ApplyLowQualityModels(object)

    if not CONFIG.Performance.LowQualityModels then
        return
    end

    if not object then
        return
    end

    pcall(function()

        if object:IsA("MeshPart") then

            SafeSet(
                object,
                "RenderFidelity",
                Enum.RenderFidelity.Performance
            )

        elseif object:IsA("BasePart") then

            SafeSet(
                object,
                "CastShadow",
                false
            )

        end

    end)
end

local function ApplyResetMaterials(object)

    if not CONFIG.Performance.ResetMaterials then
        return
    end

    if not object then
        return
    end

    pcall(function()

        if object:IsA("BasePart") then

            SafeSet(
                object,
                "Material",
                Enum.Material.SmoothPlastic
            )

            SafeSet(
                object,
                "Reflectance",
                0
            )

        end

    end)
end

local function ApplyRemoveParticles(object)

    if not CONFIG.Performance.RemoveParticles then
        return
    end

    if not object then
        return
    end

    pcall(function()

        if object:IsA("ParticleEmitter")
            or object:IsA("Trail")
            or object:IsA("Beam")
            or object:IsA("Smoke")
            or object:IsA("Fire")
            or object:IsA("Sparkles") then

            SafeDestroy(object)

        end

    end)
end

local function ApplyRemoveLights(object)

    if not CONFIG.Performance.RemoveLights then
        return
    end

    if not object then
        return
    end

    pcall(function()

        if object:IsA("PointLight")
            or object:IsA("SpotLight")
            or object:IsA("SurfaceLight") then

            SafeDestroy(object)

        end

    end)
end

local function ApplyPerformanceObject(object)

    if not object
        or not object.Parent then

        return
    end

    ApplyNoClothes(object)
    ApplyNoShadows(object)
    ApplyLowQualityParts(object)
    ApplyLowQualityModels(object)
    ApplyResetMaterials(object)
    ApplyRemoveParticles(object)
    ApplyRemoveLights(object)
end

local function ScanWorkspaceOnce()

    pcall(function()

        for _, object in ipairs(
            Workspace:GetDescendants()
        ) do

            ApplyPerformanceObject(
                object
            )

        end

    end)

    ApplyNoCameraEffects()
    ApplyLowRendering()

    ApplyLowWater(
        Workspace:FindFirstChildOfClass(
            "Terrain"
        )
    )
end

local function SetupPerformanceConnections()

    DisconnectList(
        PerformanceConnections
    )

    PerformanceConnections.DescendantAdded =
        Workspace.DescendantAdded:Connect(
            function(object)

                task.defer(function()

                    if object
                        and object.Parent then

                        ApplyPerformanceObject(
                            object
                        )

                    end

                end)

            end
        )

    PerformanceConnections.LightingAdded =
        Lighting.ChildAdded:Connect(
            function(object)

                task.defer(function()

                    ApplyNoCameraEffects()

                    if object then

                        ApplyRemoveLights(
                            object
                        )

                    end

                end)

            end
        )
end

--==================================================--
-- STRETCHER
--==================================================--

local StretchConnection = nil

local function DisconnectStretch()

    if StretchConnection then

        pcall(function()

            StretchConnection:Disconnect()

        end)

        StretchConnection = nil

    end
end

local function ApplyRealStretch()

    if not StretchEnabled then
        return
    end

    local Camera =
        Workspace.CurrentCamera

    if not Camera then
        return
    end

    local scale =
        math.clamp(
            StretchValue,
            CONFIG.StretchMin,
            CONFIG.StretchMax
        )

    pcall(function()

        Camera.CFrame =
            Camera.CFrame
            * CFrame.new(
                0,
                0,
                0,
                1, 0, 0,
                0, scale, 0,
                0, 0, 1
            )

    end)
end

local function SetStretchEnabled(
    enabled
)

    StretchEnabled =
        enabled == true

    DisconnectStretch()

    if StretchEnabled then

        StretchConnection =
            RunService.RenderStepped:Connect(
                ApplyRealStretch
            )

    end

    SaveSettings()
end

local function SetStretchValue(value)

    local number =
        tonumber(value)

    if not number then
        return false
    end

    number =
        math.clamp(
            number,
            CONFIG.StretchMin,
            CONFIG.StretchMax
        )

    StretchValue =
        number

    SaveSettings()

    return true
end

--==================================================--
-- SKY SYSTEM
--==================================================--

local CurrentSky = nil
local SkyLoading = false

local function FindSky(root)

    if not root then
        return nil
    end

    if root:IsA("Sky") then
        return root
    end

    return root:FindFirstChildWhichIsA(
        "Sky",
        true
    )
end

local function CloneSkyProperties(
    sourceSky,
    targetSky
)

    if not sourceSky
        or not targetSky then

        return false
    end

    local properties = {

        "SkyboxBk",
        "SkyboxDn",
        "SkyboxFt",
        "SkyboxLf",
        "SkyboxRt",
        "SkyboxUp",

        "SunAngularSize",
        "SunTextureId",

        "MoonTextureId",
        "MoonAngularSize",

        "StarCount",
        "CelestialBodiesShown"
    }

    for _, property in ipairs(
        properties
    ) do

        pcall(function()

            local value =
                sourceSky[property]

            if value ~= nil then

                targetSky[property] =
                    value

            end

        end)

    end

    return true
end

local function RemoveCurrentSky()

    pcall(function()

        for _, object in ipairs(
            Lighting:GetChildren()
        ) do

            if object:IsA("Sky") then

                SafeDestroy(object)

            end

        end

    end)

    CurrentSky = nil
end

local function LoadSkyAsset(assetId)

    local objects = {}

    pcall(function()

        local container =
            InsertService:LoadAsset(
                assetId
            )

        if container then

            table.insert(
                objects,
                container
            )

        end

    end)

    if #objects > 0 then
        return objects
    end

    pcall(function()

        if typeof(
            game.GetObjects
        ) == "function" then

            local result =
                game:GetObjects(
                    "rbxassetid://"
                    .. tostring(assetId)
                )

            if result then

                for _, object in ipairs(
                    result
                ) do

                    table.insert(
                        objects,
                        object
                    )

                end

            end

        end

    end)

    return objects
end

local function ApplySky(
    skyInfo,
    statusCallback
)

    if SkyLoading then
        return false
    end

    if not skyInfo
        or not skyInfo.Id then

        return false
    end

    SkyLoading = true

    if statusCallback then

        pcall(function()

            statusCallback(
                "CARREGANDO: "
                .. skyInfo.Name
            )

        end)

    end

    local temporaryObjects = {}

    local success, result =
        pcall(function()

            return LoadSkyAsset(
                skyInfo.Id
            )

        end)

    if success and result then

        temporaryObjects =
            result

    end

    local sourceSky = nil

    for _, object in ipairs(
        temporaryObjects
    ) do

        sourceSky =
            FindSky(object)

        if sourceSky then
            break
        end

    end

    if sourceSky then

        local newSky =
            Instance.new("Sky")

        newSky.Name =
            "SKYLARP_CurrentSky"

        local copied =
            CloneSkyProperties(
                sourceSky,
                newSky
            )

        if copied then

            RemoveCurrentSky()

            local inserted =
                pcall(function()

                    newSky.Parent =
                        Lighting

                end)

            if inserted
                and newSky.Parent ==
                    Lighting then

                CurrentSky =
                    newSky

                --================================================--
                -- SALVAR SKY IMEDIATAMENTE
                --================================================--

                SkySelected =
                    skyInfo.Name

                SaveSettings()

                if statusCallback then

                    pcall(function()

                        statusCallback(
                            "ATIVO: "
                            .. skyInfo.Name
                        )

                    end)

                end

            else

                SafeDestroy(newSky)

                if statusCallback then

                    pcall(function()

                        statusCallback(
                            "ERRO AO APLICAR"
                        )

                    end)

                end

            end

        else

            SafeDestroy(newSky)

        end

    else

        if statusCallback then

            pcall(function()

                statusCallback(
                    "ERRO: SKY NÃO ENCONTRADO"
                )

            end)

        end

    end

    for _, object in ipairs(
        temporaryObjects
    ) do

        if object
            and object ~= CurrentSky then

            SafeDestroy(object)

        end

    end

    SkyLoading = false

    return CurrentSky ~= nil
end

