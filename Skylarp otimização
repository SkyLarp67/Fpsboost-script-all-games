local function RestoreShaderSettings()
    local data = SavedSettings.Shader
    if type(data) ~= "table" then return end
    if type(data.Enabled) == "boolean" then SHADER_CONFIG.Enabled = data.Enabled end
    if type(data.LightEnabled) == "boolean" then SHADER_CONFIG.LightEnabled = data.LightEnabled end
    if type(data.LightColorEnabled) == "boolean" then SHADER_CONFIG.LightColorEnabled = data.LightColorEnabled end
    if type(data.Light) == "table" then
        if type(data.Light.R) == "number" then SHADER_CONFIG.Light.R = math.clamp(data.Light.R, 0, 255) end
        if type(data.Light.G) == "number" then SHADER_CONFIG.Light.G = math.clamp(data.Light.G, 0, 255) end
        if type(data.Light.B) == "number" then SHADER_CONFIG.Light.B = math.clamp(data.Light.B, 0, 255) end
    end
    local toggles = {"BloomEnabled", "BlurEnabled", "ColorCorrectionEnabled", "SunRaysEnabled", "AtmosphereEnabled", "ShaderSkyEnabled", "VignetteEnabled"}
    for _, key in ipairs(toggles) do
        if type(data[key]) == "boolean" then SHADER_CONFIG[key] = data[key] end
    end
    local groups = {"Bloom", "Blur", "ColorCorrection", "SunRays", "Atmosphere", "Lighting", "Vignette"}
    for _, groupName in ipairs(groups) do
        if type(data[groupName]) == "table" and type(SHADER_CONFIG[groupName]) == "table" then
            for key, value in pairs(data[groupName]) do
                if type(value) == "number" then SHADER_CONFIG[groupName][key] = value end
            end
        end
    end
end

