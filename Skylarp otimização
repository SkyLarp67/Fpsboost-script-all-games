local function InterfaceNormalizeImageId(value)
    value = tostring(value or "")
    value = value:gsub("%s+", "")
    if value == "" then
        return nil
    end

    if value:match("^rbxassetid://%d+$") then
        return value
    end

    local id = value:match("(%d+)")
    if id then
        return "rbxassetid://" .. id
    end

    return nil
end

InterfaceApplyImage = function(id, value)
    local object = InterfaceObjects[id]
    if not object then return end

    local imageId = InterfaceNormalizeImageId(value)
    local data = InterfaceSettings[id]
    if type(data) ~= "table" then
        data = {}
        InterfaceSettings[id] = data
    end

    if object:IsA("ImageLabel") or object:IsA("ImageButton") then
        object.Image = imageId or ""
        data.Image = imageId or ""
    else
        local childName = "SKYLARP_CustomImage_" .. tostring(id):gsub("[^%w_]", "_")
        local image = object:FindFirstChild(childName)

        if not imageId then
            if image then image:Destroy() end
            data.Image = ""
            SaveSettings()
            return
        end

        if not image or not image:IsA("ImageLabel") then
            if image then image:Destroy() end
            image = Create("ImageLabel", {
                Name = childName,
                Size = UDim2.fromScale(1, 1),
                Position = UDim2.fromScale(0, 0),
                BackgroundTransparency = 1,
                BorderSizePixel = 0,
                Image = imageId,
                ScaleType = Enum.ScaleType.Stretch,
                ZIndex = math.max(1, object.ZIndex + 1),
                Active = false,
                Selectable = false
            }, object)
        else
            image.Image = imageId
        end

        data.Image = imageId
    end

    SaveSettings()
end

InterfaceApplySavedImage = function(id, object, data)
    if type(data) ~= "table" or not data.Image or data.Image == "" then
        return
    end
    InterfaceApplyImage(id, data.Image)
end

local function InterfaceUpdateDragLayer()
    if not InterfaceDragLayer then return end

    local object = InterfaceSelectedId and InterfaceObjects[InterfaceSelectedId]
    if not InterfaceEditorOpen or not object or not object.Parent then
        InterfaceDragLayer.Visible = false
        return
    end

    local p = object.AbsolutePosition
    local sz = object.AbsoluteSize
    InterfaceDragLayer.Position = UDim2.fromOffset(math.floor(p.X), math.floor(p.Y))
    InterfaceDragLayer.Size = UDim2.fromOffset(math.max(8, math.floor(sz.X)), math.max(8, math.floor(sz.Y)))
    InterfaceDragLayer.Visible = true
end

local function InterfaceBeginDrag(input)
    local object = InterfaceSelectedId and InterfaceObjects[InterfaceSelectedId]
    if not object or not object.Parent then return end

    if input.UserInputType ~= Enum.UserInputType.Touch
    and input.UserInputType ~= Enum.UserInputType.MouseButton1 then
        return
    end

    InterfaceDragging = true
    InterfaceDragInput = input
    InterfaceDragStart = input.Position
    InterfaceObjectStartAbs = object.AbsolutePosition
end

local function InterfaceMoveDrag(input)
    if not InterfaceDragging or not InterfaceDragInput then return end
    if input ~= InterfaceDragInput and input.UserInputType ~= Enum.UserInputType.MouseMovement then return end

    local object = InterfaceSelectedId and InterfaceObjects[InterfaceSelectedId]
    if not object or not object.Parent then return end

    local delta = input.Position - InterfaceDragStart
    local parent = object.Parent
    local parentAbs = parent:IsA("GuiObject") and parent.AbsolutePosition or Vector2.new(0, 0)
    local parentSize = InterfaceGetParentSize(object)
    local size = object.AbsoluteSize
    local anchor = object.AnchorPoint

    -- O objeto nunca pode ser arrastado para fora dos limites do pai/tela.
    local topLeft = InterfaceObjectStartAbs + delta
    local anchorX = topLeft.X - parentAbs.X + size.X * anchor.X
    local anchorY = topLeft.Y - parentAbs.Y + size.Y * anchor.Y

    local minX = size.X * anchor.X + 2
    local maxX = parentSize.X - size.X * (1 - anchor.X) - 2
    local minY = size.Y * anchor.Y + 2
    local maxY = parentSize.Y - size.Y * (1 - anchor.Y) - 2

    if maxX < minX then
        anchorX = parentSize.X * 0.5
    else
        anchorX = math.clamp(anchorX, minX, maxX)
    end

    if maxY < minY then
        anchorY = parentSize.Y * 0.5
    else
        anchorY = math.clamp(anchorY, minY, maxY)
    end

    object.Position = UDim2.new(
        0, math.floor(anchorX + 0.5),
        0, math.floor(anchorY + 0.5)
    )

    InterfaceSaveObject(InterfaceSelectedId, object)
    InterfaceUpdateGuide()
    InterfaceRefreshEditor()
end

local function InterfaceEndDrag(input)
    if not InterfaceDragging then return end
    if InterfaceDragInput and input ~= InterfaceDragInput
    and input.UserInputType ~= Enum.UserInputType.MouseButton1 then
        return
    end

    InterfaceDragging = false
    InterfaceDragInput = nil
    InterfaceDragStart = nil
    InterfaceObjectStartAbs = nil
    SaveSettings()
end


local function InterfaceUpdateGuide()
    if not InterfaceGuide then
        return
    end

    local id = InterfaceSelectedId
    local object = id and InterfaceObjects[id]

    if not object or not object.Parent then
        InterfaceGuide.Visible = false
        return
    end

    pcall(function()
        local position = object.AbsolutePosition
        local size = object.AbsoluteSize

        if size.X < 1 or size.Y < 1 then
            InterfaceGuide.Visible = false
            return
        end

        InterfaceGuide.Position = UDim2.fromOffset(
            math.floor(position.X + 0.5),
            math.floor(position.Y + 0.5)
        )
        InterfaceGuide.Size = UDim2.fromOffset(
            math.max(8, math.floor(size.X + 0.5)),
            math.max(8, math.floor(size.Y + 0.5))
        )
        InterfaceGuide.Visible = true
        InterfaceUpdateDragLayer()
    end)
end

local function InterfaceRefreshEditor()
    if not InterfaceEditor or not InterfaceSelectedId then
        return
    end

    local object = InterfaceObjects[InterfaceSelectedId]
    if not object then
        return
    end

    local sizeX = InterfaceEditor:FindFirstChild("SizeX")
    local sizeY = InterfaceEditor:FindFirstChild("SizeY")
    local posX = InterfaceEditor:FindFirstChild("PosX")
    local posY = InterfaceEditor:FindFirstChild("PosY")

    if sizeX then sizeX.Text = tostring(math.floor(object.AbsoluteSize.X + 0.5)) end
    if sizeY then sizeY.Text = tostring(math.floor(object.AbsoluteSize.Y + 0.5)) end
    if posX then posX.Text = tostring(math.floor(object.Position.X.Offset + 0.5)) end
    if posY then posY.Text = tostring(math.floor(object.Position.Y.Offset + 0.5)) end

    local selected = InterfaceEditor:FindFirstChild("SelectedName")
    if selected then
        selected.Text = "ID: " .. InterfaceSelectedId
    end

    local imageBox = InterfaceEditor:FindFirstChild("ImageId")
    if imageBox then
        local data = InterfaceSettings[InterfaceSelectedId]
        imageBox.Text = type(data) == "table" and tostring(data.Image or "") or ""
    end

    InterfaceUpdateGuide()
    InterfaceUpdateDragLayer()
end

local function InterfaceSetAbsolute(object, width, height, x, y)
    if not object then
        return
    end

    local parentSize = InterfaceGetParentSize(object)
    local safeWidth = math.clamp(tonumber(width) or object.AbsoluteSize.X, 20, math.max(20, parentSize.X))
    local safeHeight = math.clamp(tonumber(height) or object.AbsoluteSize.Y, 20, math.max(20, parentSize.Y))

    object.Size = UDim2.fromOffset(safeWidth, safeHeight)
    object.Position = UDim2.fromOffset(
        tonumber(x) or object.Position.X.Offset,
        tonumber(y) or object.Position.Y.Offset
    )

    InterfaceClampObject(object)
end

local function InterfaceSelect(id)
    if not InterfaceObjects[id] then
        return
    end

    InterfaceSelectedId = id
    local object = InterfaceObjects[id]
    if object then
        InterfaceClampObject(object)
    end
    InterfaceRefreshEditor()
    InterfaceUpdateDragLayer()
end

local function InterfaceIncreaseSize(id)
    local object = id and InterfaceObjects[id]
    if not object then return end

    local parentSize = InterfaceGetParentSize(object)
    local current = object.AbsoluteSize
    local nextW = math.clamp(math.floor(current.X + 10 + 0.5), 20, math.max(20, parentSize.X))
    local nextH = math.clamp(math.floor(current.Y + 10 + 0.5), 20, math.max(20, parentSize.Y))

    object.Size = UDim2.fromOffset(nextW, nextH)
    InterfaceClampObject(object)
    InterfaceSaveObject(id, object)
    SaveSettings()
    InterfaceRefreshEditor()
    InterfaceUpdateGuide()
end

