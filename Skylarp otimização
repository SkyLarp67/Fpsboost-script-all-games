--==================================================--
-- DRAG MOBILE
--==================================================--

local function MakeDraggable(
    object,
    handle
)

    if not object or not handle then
        return
    end

    local dragging = false
    local dragInput = nil
    local dragStart = nil
    local startPosition = nil

    local function getParentMetrics()
        local parent = object.Parent

        if parent and parent:IsA("GuiObject") then
            return parent.AbsoluteSize, parent.AbsolutePosition
        end

        local camera = Workspace.CurrentCamera
        return (
            camera and camera.ViewportSize
        ) or Vector2.new(800, 600), Vector2.new(0, 0)
    end

    local function clampXY(x, y)
        local parentSize = getParentMetrics()
        local size = object.AbsoluteSize
        local anchor = object.AnchorPoint

        -- Limita também o tamanho para garantir que sempre exista uma
        -- posição possível dentro da área pai/tela.
        local maxWidth = math.max(8, parentSize.X - 4)
        local maxHeight = math.max(8, parentSize.Y - 4)

        if size.X > maxWidth then
            object.Size = UDim2.fromOffset(maxWidth, size.Y)
            size = object.AbsoluteSize
        end

        if size.Y > maxHeight then
            object.Size = UDim2.fromOffset(size.X, maxHeight)
            size = object.AbsoluteSize
        end

        local minX = size.X * anchor.X + 2
        local maxX = parentSize.X - size.X * (1 - anchor.X) - 2
        local minY = size.Y * anchor.Y + 2
        local maxY = parentSize.Y - size.Y * (1 - anchor.Y) - 2

        if maxX < minX then
            x = parentSize.X * 0.5
        else
            x = math.clamp(x, minX, maxX)
        end

        if maxY < minY then
            y = parentSize.Y * 0.5
        else
            y = math.clamp(y, minY, maxY)
        end

        return math.floor(x + 0.5), math.floor(y + 0.5)
    end

    local function forceInside()
        local parentSize = getParentMetrics()
        local x = object.Position.X.Scale * parentSize.X + object.Position.X.Offset
        local y = object.Position.Y.Scale * parentSize.Y + object.Position.Y.Offset
        local cx, cy = clampXY(x, y)
        object.Position = UDim2.fromOffset(cx, cy)
    end

    handle.InputBegan:Connect(function(input)
        if input.UserInputType ~= Enum.UserInputType.Touch
        and input.UserInputType ~= Enum.UserInputType.MouseButton1 then
            return
        end

        -- Primeiro corrige qualquer posição antiga inválida.
        forceInside()

        dragging = true
        dragInput = input
        dragStart = input.Position
        startPosition = object.Position
    end)

    UserInputService.InputChanged:Connect(function(input)
        if not dragging or not dragInput then
            return
        end

        if dragInput.UserInputType == Enum.UserInputType.Touch then
            if input ~= dragInput then
                return
            end
        elseif input.UserInputType ~= Enum.UserInputType.MouseMovement then
            return
        end

        local delta = input.Position - dragStart
        local parentSize = getParentMetrics()

        local x = startPosition.X.Scale * parentSize.X
            + startPosition.X.Offset
            + delta.X
        local y = startPosition.Y.Scale * parentSize.Y
            + startPosition.Y.Offset
            + delta.Y

        local cx, cy = clampXY(x, y)
        object.Position = UDim2.fromOffset(cx, cy)
    end)

    UserInputService.InputEnded:Connect(function(input)
        if not dragging then
            return
        end

        if input == dragInput
        or (
            dragInput
            and dragInput.UserInputType == Enum.UserInputType.MouseButton1
            and input.UserInputType == Enum.UserInputType.MouseButton1
        ) then
            dragging = false
            dragInput = nil
            dragStart = nil
            startPosition = nil

            -- Última correção antes de salvar.
            forceInside()

            if object == HUD then
                SavedHUDPosition.X = HUD.Position.X.Offset
                SavedHUDPosition.Y = HUD.Position.Y.Offset
            end

            pcall(SaveSettings)
        end
    end)

    -- Corrige automaticamente quando a GUI é criada ou a resolução muda.
    task.defer(function()
        pcall(forceInside)
    end)
end

