    local function refresh(value)
        local range = max - min
        local alpha = range > 0 and math.clamp((value - min) / range, 0, 1) or 0
        fill.Size = UDim2.new(alpha,0,1,0)
        knob.Position = UDim2.new(alpha,0,0.5,0)
        valueLabel.Text = formatValue(value)
    end
    local function setFromX(x, save)
        local left = track.AbsolutePosition.X
        local width = track.AbsoluteSize.X
        if width <= 0 then return end
        local alpha = math.clamp((x - left) / width, 0, 1)
        local value = min + (max - min) * alpha
        local step = 10 ^ decimals
        value = math.round(value * step) / step
        value = math.clamp(value, min, max)
        SHADER_CONFIG[group][key] = value
        refresh(value)
        if SHADER_CONFIG.Enabled then ApplyShaders() end
        if save then SaveSettings() end
    end
    local initial = ClampNumber(SHADER_CONFIG[group][key], min, max, min)
    SHADER_CONFIG[group][key] = initial
    refresh(initial)
    track.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            dragInput = input
            setFromX(input.Position.X, false)
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if not dragging then return end
        if input.UserInputType == Enum.UserInputType.MouseMovement or input == dragInput then setFromX(input.Position.X, false) end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if dragInput and (input == dragInput or (dragInput.UserInputType == Enum.UserInputType.MouseButton1 and input.UserInputType == Enum.UserInputType.MouseButton1)) then
            dragging = false
            dragInput = nil
            SaveSettings()
        end
    end)
    return row
end

