local function SetPerformanceOption(
    option,
    enabled
)

    if CONFIG.Performance[option] == nil then
        return
    end

    CONFIG.Performance[option] =
        enabled == true

    if enabled then

        task.spawn(function()
            pcall(ScanWorkspaceOnce)
        end)
    end

    SaveSettings()
end

