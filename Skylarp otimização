local HUD = nil

local function SaveSettings()

    if not CONFIG.AutoSave then
        return
    end

    if not CanUseFileSystem() then
        return
    end

    local hudX =
        SavedHUDPosition.X

    local hudY =
        SavedHUDPosition.Y

    if HUD then

        pcall(function()

            hudX =
                HUD.Position.X.Offset

            hudY =
                HUD.Position.Y.Offset

        end)

    end

    local data = {

        --================================================--
        -- STRETCH
        --================================================--

        StretchValue =
            StretchValue
            or CONFIG.StretchDefault,

        StretchEnabled =
            StretchEnabled
            or false,

        --================================================--
        -- SKY
        --================================================--

        SkySelected =
            SkySelected
            or "",

        --================================================--
        -- HUD
        --================================================--

        HUDPosition = {

            X = hudX,

            Y = hudY
        },

        --================================================--
        -- PERFORMANCE
        --================================================--

        Performance = {}
    }

    for name, value in pairs(
        CONFIG.Performance
    ) do

        data.Performance[name] =
            value

    end

    local success, encoded =
        pcall(function()

            return HttpService:JSONEncode(
                data
            )

        end)

    if not success
        or not encoded then

        return
    end

    pcall(function()

        writefile(
            CONFIG.SaveFile,
            encoded
        )

    end)
end

