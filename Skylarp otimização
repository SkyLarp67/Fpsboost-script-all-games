                TextSize = 20,
                Font = Enum.Font.GothamBold,
                ZIndex = 220
            },
            LightPicker
        )
        AddCorner(close, 8)

        -- RODA: vários raios formam o espectro. O centro é branco,
        -- a distância do centro controla a saturação.
        local wheelSize = 270
        local wheelRadius = 129

        local wheel = Create(
            "Frame",
            {
                Size = UDim2.fromOffset(wheelSize, wheelSize),
                Position = UDim2.fromOffset(18, 58),
                BackgroundTransparency = 1,
                BorderSizePixel = 0,
                ZIndex = 201,
                Active = true,
                ClipsDescendants = true
            },
            LightPicker
        )

        -- 180 segmentos: suficientemente suave no celular sem criar centenas
        -- de objetos desnecessários.
        for i = 0, 179 do
            local hueValue = i / 180
            Create(
                "Frame",
                {
                    Size = UDim2.fromOffset(3, wheelRadius),
                    Position = UDim2.new(0.5, 0, 0.5, 0),
                    AnchorPoint = Vector2.new(0.5, 1),
