    end

    --================================================--
    -- BLUR
    --==================================================

    if SHADER_CONFIG.BlurEnabled then

        local Blur =
            Instance.new("BlurEffect")

        Blur.Name = "CustomBlur"

        Blur.Size =
            SHADER_CONFIG.Blur.Size

        Blur.Parent = Lighting
    end

    --================================================--
