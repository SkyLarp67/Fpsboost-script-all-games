local CurrentSky = nil
local SkyLoading = false

local function FindSky(root)

    if not root then
        return nil
    end

    if root:IsA("Sky") then
        return root
    end

    return root:FindFirstChildWhichIsA(
        "Sky",
        true
    )
end

local function CloneSkyProperties(
    sourceSky,
    targetSky
)

    if not sourceSky
    or not targetSky then
        return false
    end

    local properties = {
        "SkyboxBk",
        "SkyboxDn",
        "SkyboxFt",
        "SkyboxLf",
        "SkyboxRt",
        "SkyboxUp",
        "SunAngularSize",
        "SunTextureId",
        "MoonTextureId",
        "MoonAngularSize",
        "StarCount",
        "CelestialBodiesShown"
    }

    for _, property in ipairs(properties) do

        pcall(function()

            local value =
                sourceSky[property]

            if value ~= nil then
                targetSky[property] = value
            end
        end)
    end

    return true
end

local function RemoveCurrentSky()

    pcall(function()

        local selected =
            Lighting:FindFirstChild(
                "SKYLARP_CurrentSky"
            )

        if selected then
            SafeDestroy(selected)
        end

        local shaderSky =
            Lighting:FindFirstChild(
                "CustomSky"
            )

        if shaderSky then
            SafeDestroy(shaderSky)
        end
    end)

    CurrentSky = nil
end

local function LoadSkyAsset(assetId)

    local objects = {}

    pcall(function()

        local container =
            InsertService:LoadAsset(assetId)

        if container then
            table.insert(objects, container)
        end
    end)

    if #objects > 0 then
        return objects
    end

    pcall(function()

        if typeof(game.GetObjects) == "function" then

            local result =
                game:GetObjects(
                    "rbxassetid://"
                    .. tostring(assetId)
                )

            if result then

                for _, object in ipairs(result) do
                    table.insert(objects, object)
                end
            end
        end
    end)

    return objects
end

local function ApplySky(
    skyInfo,
    statusCallback
)

    if SkyLoading then
        return false
    end

    if not skyInfo
    or not skyInfo.Id then
        return false
    end

    SkyLoading = true

    if statusCallback then

        pcall(function()

            statusCallback(
                "CARREGANDO: "
                .. skyInfo.Name
            )
        end)
    end

    local temporaryObjects = {}

    local success, result =
        pcall(function()
            return LoadSkyAsset(skyInfo.Id)
        end)

    if success and result then
        temporaryObjects = result
    end

    local sourceSky = nil

    for _, object in ipairs(temporaryObjects) do

        sourceSky = FindSky(object)

        if sourceSky then
            break
        end
    end

    if sourceSky then

        local newSky =
            Instance.new("Sky")

        newSky.Name =
            "SKYLARP_CurrentSky"

        local copied =
            CloneSkyProperties(
                sourceSky,
                newSky
            )

        if copied then

            local oldSky =
                Lighting:FindFirstChild(
                    "SKYLARP_CurrentSky"
                )

            if oldSky then
                SafeDestroy(oldSky)
            end

            local oldShader =
                Lighting:FindFirstChild(
                    "CustomSky"
                )

            if oldShader then
                SafeDestroy(oldShader)
            end

            local inserted =
                pcall(function()
                    newSky.Parent = Lighting
                end)

            if inserted
            and newSky.Parent == Lighting then

                CurrentSky = newSky
                SkySelected = skyInfo.Name
                if type(skyInfo.Id) == "number" then
                    SkySelectedId = skyInfo.Id
                end

                SaveSettings()

                if statusCallback then

                    pcall(function()

                        statusCallback(
                            "ATIVO: "
                            .. skyInfo.Name
                        )
                    end)
                end

            else

                SafeDestroy(newSky)
            end

        else

            SafeDestroy(newSky)
        end

    else

        if statusCallback then

            pcall(function()

                statusCallback(
                    "ERRO: SKY NÃO ENCONTRADO"
                )
            end)
        end
    end

    for _, object in ipairs(temporaryObjects) do

        if object then
            SafeDestroy(object)
        end
    end

    SkyLoading = false

    return CurrentSky ~= nil
end

