            RGB(
                SHADER_CONFIG.Atmosphere.DecayR,
                SHADER_CONFIG.Atmosphere.DecayG,
                SHADER_CONFIG.Atmosphere.DecayB
            )

        Atm.Glare =
            SHADER_CONFIG.Atmosphere.Glare

        Atm.Haze =
            SHADER_CONFIG.Atmosphere.Haze

        Atm.Parent = Lighting
    end

    --================================================--
    -- SHADER SKY
    --==================================================--

    if SHADER_CONFIG.ShaderSkyEnabled
    and not CurrentSky
    and not SkySelected then

        local Sky =
            Instance.new("Sky")

        Sky.Name =
            "CustomSky"

        Sky.SkyboxBk =
            SHADER_CONFIG.ShaderSky.SkyboxBk

        Sky.SkyboxDn =
            SHADER_CONFIG.ShaderSky.SkyboxDn

        Sky.SkyboxFt =
            SHADER_CONFIG.ShaderSky.SkyboxFt

        Sky.SkyboxLf =
            SHADER_CONFIG.ShaderSky.SkyboxLf

