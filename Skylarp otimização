local function ApplyNoCameraEffects()

    if not CONFIG.Performance.NoCameraEffects then
        return
    end

    pcall(function()

        for _, object in ipairs(Lighting:GetChildren()) do

            if object:IsA("PostEffect")
            and not IsSKYLARPEffect(object) then

                SafeDestroy(object)
            end
        end
    end)
end

