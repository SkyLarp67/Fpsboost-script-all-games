        local wheelDragging = false
        local wheelInput = nil
        local brightnessDragging = false
        local brightnessInput = nil

        local function UpdateColorFromHSV()
            local color = Color3.fromHSV(PickerHue, PickerSat, PickerVal)
            local r = math.floor(color.R * 255 + 0.5)
            local g = math.floor(color.G * 255 + 0.5)
            local b = math.floor(color.B * 255 + 0.5)

            -- Atualiza somente a seleção/prévia. A LUZ real só muda no OK.
            SHADER_CONFIG.Light.R = r
            SHADER_CONFIG.Light.G = g
            SHADER_CONFIG.Light.B = b

            marker.BackgroundColor3 = color
            markerInner.BackgroundColor3 = color
            preview.BackgroundColor3 = color
            brightnessKnob.BackgroundColor3 = color

            local angle = PickerHue * math.pi * 2 - math.pi / 2
            local markerRadius = PickerSat * (wheelRadius - 10)
            local markerX = math.cos(angle) * markerRadius
            local markerY = math.sin(angle) * markerRadius

            if PickerSat <= 0.001 then
                markerX = 0
                markerY = 0
            end

            marker.Position = UDim2.new(0.5, markerX, 0.5, markerY)

            brightness.BackgroundColor3 = Color3.fromHSV(PickerHue, PickerSat, 1)
            brightnessKnob.Position = UDim2.new(PickerVal, 0, 0.5, 0)

            info.Text = string.format(
                "HEX: %s    RGB: %d, %d, %d",
                ColorToHex(color), r, g, b
            )
        end

        local function SetWheelFromPosition(inputPosition)
            local pos = wheel.AbsolutePosition
            local size = wheel.AbsoluteSize
            local center = pos + size / 2
            local dx = inputPosition.X - center.X
            local dy = inputPosition.Y - center.Y
            local distance = math.sqrt(dx * dx + dy * dy)
            local maxDistance = wheelRadius - 2
            local limitedDistance = math.min(distance, maxDistance)

            if distance > 0.001 then
                local angle = math.atan2(dy, dx)
                PickerHue = (angle / (math.pi * 2) + 0.25) % 1
            end

            PickerSat = math.clamp(limitedDistance / maxDistance, 0, 1)
            UpdateColorFromHSV()
        end

        local function SetBrightnessFromPosition(inputPosition)
            local pos = brightness.AbsolutePosition
            local size = brightness.AbsoluteSize
            PickerVal = math.clamp((inputPosition.X - pos.X) / size.X, 0, 1)
            UpdateColorFromHSV()
        end

        wheel.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.Touch
            or input.UserInputType == Enum.UserInputType.MouseButton1 then
                wheelDragging = true
                wheelInput = input
                SetWheelFromPosition(input.Position)
            end
        end)

        brightnessHit.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.Touch
            or input.UserInputType == Enum.UserInputType.MouseButton1 then
                brightnessDragging = true
                brightnessInput = input
                SetBrightnessFromPosition(input.Position)
            end
        end)

        UserInputService.InputChanged:Connect(function(input)
            if wheelDragging and (input == wheelInput or input.UserInputType == Enum.UserInputType.MouseMovement) then
                SetWheelFromPosition(input.Position)
            end
            if brightnessDragging and (input == brightnessInput or input.UserInputType == Enum.UserInputType.MouseMovement) then
                SetBrightnessFromPosition(input.Position)
            end
        end)

        UserInputService.InputEnded:Connect(function(input)
            if input == wheelInput or (wheelInput and wheelInput.UserInputType == Enum.UserInputType.MouseButton1 and input.UserInputType == Enum.UserInputType.MouseButton1) then
                wheelDragging = false
                wheelInput = nil
            end
            if input == brightnessInput or (brightnessInput and brightnessInput.UserInputType == Enum.UserInputType.MouseButton1 and input.UserInputType == Enum.UserInputType.MouseButton1) then
                brightnessDragging = false
                brightnessInput = nil
            end
        end)

        close.Activated:Connect(function()
            if PickerOriginalLight then
                SHADER_CONFIG.Light.R = PickerOriginalLight.R
                SHADER_CONFIG.Light.G = PickerOriginalLight.G
                SHADER_CONFIG.Light.B = PickerOriginalLight.B
            end
            LightColorButton.BackgroundColor3 = GetLightColor()
            LightPicker.Visible = false
            LightPickerOpen = false
        end)

        cancelButton.Activated:Connect(function()
            if PickerOriginalLight then
                SHADER_CONFIG.Light.R = PickerOriginalLight.R
                SHADER_CONFIG.Light.G = PickerOriginalLight.G
                SHADER_CONFIG.Light.B = PickerOriginalLight.B
            end
            LightColorButton.BackgroundColor3 = GetLightColor()
            LightPicker.Visible = false
            LightPickerOpen = false
        end)

        okButton.Activated:Connect(function()
            LightColorButton.BackgroundColor3 = GetLightColor()
            ApplySelectedLightColor()
            LightPicker.Visible = false
            LightPickerOpen = false
        end)

        -- Mantém uma referência segura para atualizar a prévia ao reabrir.
        PickerUpdate = UpdateColorFromHSV
        LightPicker:SetAttribute("SKYLARP_ColorPickerReady", true)
    end

    PickerOriginalLight = {
        R = SHADER_CONFIG.Light.R,
        G = SHADER_CONFIG.Light.G,
        B = SHADER_CONFIG.Light.B
    }

    local current = GetLightColor()
    PickerHue, PickerSat, PickerVal = Color3.toHSV(current)

    if PickerUpdate then
        PickerUpdate()
    end

    LightColorButton.BackgroundColor3 = current
    LightPicker.Visible = true
    LightPickerOpen = true
end

