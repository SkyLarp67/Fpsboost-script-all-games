local function ApplyHDLight()

    local L =
        SHADER_CONFIG.Light

    if SHADER_CONFIG.LightEnabled then

        -- A luz continua ativa mesmo quando a COR estiver OFF.
        -- COR OFF = usa as cores originais do Roblox, sem apagar a luz.
        if SHADER_CONFIG.LightColorEnabled then

            SafeSet(
                Lighting,
                "Ambient",
                RGB(
                    L.R,
                    L.G,
                    L.B
                )
            )

            SafeSet(
                Lighting,
                "OutdoorAmbient",
                RGB(
                    L.R,
                    L.G,
                    L.B
                )
            )

        else

            SafeSet(
                Lighting,
                "Ambient",
                ShaderOriginal.Ambient
                    or Color3.fromRGB(128, 128, 128)
            )

            SafeSet(
                Lighting,
                "OutdoorAmbient",
                ShaderOriginal.OutdoorAmbient
                    or Color3.fromRGB(128, 128, 128)
            )

        end

        SafeSet(
            Lighting,
            "Brightness",
            SHADER_CONFIG.Lighting.Brightness
        )

    else

        -- LUZ OFF
        SafeSet(
            Lighting,
            "Ambient",
            Color3.fromRGB(0, 0, 0)
        )

        SafeSet(
            Lighting,
            "OutdoorAmbient",
            Color3.fromRGB(0, 0, 0)
        )

        SafeSet(
            Lighting,
            "Brightness",
            0
        )
    end
end

