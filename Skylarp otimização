local function IsCharacterPart(object)
    if not object then return false end
    local model = object:FindFirstAncestorOfClass("Model")
    if not model then return false end
    return Players:GetPlayerFromCharacter(model) ~= nil
end

local HD_EFFECT_NAMES = {CustomBloom = true, CustomBlur = true, CustomColor = true, CustomSunRays = true, CustomAtmosphere = true, CustomSky = true}
local function IsSKYLARPEffect(object)
    if not object then return false end
    return HD_EFFECT_NAMES[object.Name] == true
end

local function ApplyNoCameraEffects()
    if not CONFIG.Performance.NoCameraEffects then return end
    pcall(function()
        for _, object in ipairs(Lighting:GetChildren()) do
            if object:IsA("PostEffect") and not IsSKYLARPEffect(object) then SafeDestroy(object) end
        end
    end)
end

local function ApplyNoClothes(object)
    if not CONFIG.Performance.NoClothes then return end
    if not object then return end
    pcall(function()
        if object:IsA("Shirt") or object:IsA("Pants") or object:IsA("ShirtGraphic") or object:IsA("CharacterMesh") then
            SafeDestroy(object)
            return
        end
        if object:IsA("Accessory") and IsCharacterPart(object) then SafeDestroy(object) end
    end)
end

local function ApplyLowWater(object)
    if not CONFIG.Performance.LowWaterGraphics then return end
    if not object then return end
    pcall(function()
        if object:IsA("Terrain") then
            SafeSet(object, "WaterWaveSize", 0)
            SafeSet(object, "WaterWaveSpeed", 0)
            SafeSet(object, "WaterReflectance", 0)
            SafeSet(object, "WaterTransparency", 1)
        end
    end)
end

local function ApplyNoShadows(object)
    if not CONFIG.Performance.NoShadows then return end
    if not object then return end
    pcall(function()
        if object:IsA("BasePart") then SafeSet(object, "CastShadow", false) end
    end)
end

local function ApplyLowRendering()
    if not CONFIG.Performance.LowRendering then return end
    pcall(function() settings().Rendering.QualityLevel = Enum.QualityLevel.Level01 end)
    if not SHADER_CONFIG.Enabled then
        pcall(function() Lighting.GlobalShadows = false end)
    end
end

local function ApplyLowQualityParts(object)
