            brightnessInput = input
            SetBrightnessFromPosition(input.Position)
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if wheelDragging then
            if input.UserInputType == Enum.UserInputType.MouseMovement
            or input == wheelInput then
                SetWheelFromPosition(input.Position)
            end
        end

        if brightnessDragging then
            if input.UserInputType == Enum.UserInputType.MouseMovement
            or input == brightnessInput then
                SetBrightnessFromPosition(input.Position)
            end
        end
    end)

    UserInputService.InputEnded:Connect(function(input)
        if wheelInput and (
            input == wheelInput
            or (wheelInput.UserInputType == Enum.UserInputType.MouseButton1
                and input.UserInputType == Enum.UserInputType.MouseButton1)
        ) then
            wheelDragging = false
            wheelInput = nil
        end

        if brightnessInput and (
            input == brightnessInput
            or (brightnessInput.UserInputType == Enum.UserInputType.MouseButton1
                and input.UserInputType == Enum.UserInputType.MouseButton1)
        ) then
            brightnessDragging = false
            brightnessInput = nil
        end
    end)

    close.Activated:Connect(function()
        LightPicker.Visible = false
        LightPickerOpen = false
    end)

    okButton.Activated:Connect(function()
        LightPicker.Visible = false
        LightPickerOpen = false
        SaveSettings()
    end)

    cancelButton.Activated:Connect(function()
        LightPicker.Visible = false
        LightPickerOpen = false
    end)

    UpdateColorFromHSV(false)
    LightPickerOpen = true
end

