local function ApplyShaders()

    RemoveShaderEffects()

    if not SHADER_CONFIG.Enabled then
        return
    end

    CaptureLighting()

    --================================================--
    -- BLOOM
    --==================================================

    if SHADER_CONFIG.BloomEnabled then

        local Bloom =
            Instance.new("BloomEffect")

        Bloom.Name = "CustomBloom"

        Bloom.Intensity =
            SHADER_CONFIG.Bloom.Intensity

        Bloom.Size =
            SHADER_CONFIG.Bloom.Size

        Bloom.Threshold =
            SHADER_CONFIG.Bloom.Threshold

        Bloom.Parent = Lighting
    end

    --================================================--
    -- BLUR
    --==================================================

    if SHADER_CONFIG.BlurEnabled then

        local Blur =
            Instance.new("BlurEffect")

        Blur.Name = "CustomBlur"

        Blur.Size =
            SHADER_CONFIG.Blur.Size

        Blur.Parent = Lighting
    end

    --================================================--
    -- COLOR CORRECTION
    --==================================================

    if SHADER_CONFIG.ColorCorrectionEnabled then

        local ColorCor =
            Instance.new(
                "ColorCorrectionEffect"
            )

        ColorCor.Name =
            "CustomColor"

        ColorCor.Brightness =
            SHADER_CONFIG.ColorCorrection.Brightness

        ColorCor.Contrast =
            SHADER_CONFIG.ColorCorrection.Contrast

        ColorCor.Saturation =
            SHADER_CONFIG.ColorCorrection.Saturation

        ColorCor.TintColor =
            RGB(
                SHADER_CONFIG.ColorCorrection.TintR,
                SHADER_CONFIG.ColorCorrection.TintG,
                SHADER_CONFIG.ColorCorrection.TintB
            )

        ColorCor.Parent = Lighting
    end

    --================================================--
    -- SUN RAYS
    --==================================================

    if SHADER_CONFIG.SunRaysEnabled then

        local SunRays =
            Instance.new("SunRaysEffect")

        SunRays.Name =
            "CustomSunRays"

        SunRays.Intensity =
            SHADER_CONFIG.SunRays.Intensity

        SunRays.Spread =
            SHADER_CONFIG.SunRays.Spread

        SunRays.Parent = Lighting
    end

    --================================================--
    -- ATMOSPHERE
    --==================================================

    if SHADER_CONFIG.AtmosphereEnabled then

        local Atm =
            Instance.new("Atmosphere")

        Atm.Name =
            "CustomAtmosphere"

        Atm.Density =
            SHADER_CONFIG.Atmosphere.Density

        Atm.Offset =
            SHADER_CONFIG.Atmosphere.Offset

        Atm.Color =
            RGB(
                SHADER_CONFIG.Atmosphere.ColorR,
                SHADER_CONFIG.Atmosphere.ColorG,
                SHADER_CONFIG.Atmosphere.ColorB
            )

        Atm.Decay =
            RGB(
                SHADER_CONFIG.Atmosphere.DecayR,
                SHADER_CONFIG.Atmosphere.DecayG,
                SHADER_CONFIG.Atmosphere.DecayB
            )

        Atm.Glare =
            SHADER_CONFIG.Atmosphere.Glare

        Atm.Haze =
            SHADER_CONFIG.Atmosphere.Haze

        Atm.Parent = Lighting
    end

    --================================================--
    -- SHADER SKY
    --==================================================--

    if SHADER_CONFIG.ShaderSkyEnabled
    and not CurrentSky
    and not SkySelected then

        local Sky =
            Instance.new("Sky")

        Sky.Name =
            "CustomSky"

        Sky.SkyboxBk =
            SHADER_CONFIG.ShaderSky.SkyboxBk

        Sky.SkyboxDn =
            SHADER_CONFIG.ShaderSky.SkyboxDn

        Sky.SkyboxFt =
            SHADER_CONFIG.ShaderSky.SkyboxFt

        Sky.SkyboxLf =
            SHADER_CONFIG.ShaderSky.SkyboxLf

        Sky.SkyboxRt =
            SHADER_CONFIG.ShaderSky.SkyboxRt

        Sky.SkyboxUp =
            SHADER_CONFIG.ShaderSky.SkyboxUp

        Sky.SunAngularSize =
            SHADER_CONFIG.ShaderSky.SunAngularSize

        Sky.Parent = Lighting
    end

    --================================================--
    -- LIGHTING
    --==================================================

    ApplyShaderLighting()

    --================================================--
    -- VIGNETTE
    --==================================================

    if SHADER_CONFIG.VignetteEnabled then

        local targetParent = ScreenGui

        if not targetParent then
            targetParent = CoreGui
        end

        local Vignette =
            Instance.new("ImageLabel")

        Vignette.Name =
            "CustomVignette"

        Vignette.Size =
            UDim2.fromScale(1, 1)

        Vignette.Position =
            UDim2.fromScale(0, 0)

        Vignette.BackgroundTransparency = 1

        Vignette.Image =
            SHADER_CONFIG.Vignette.Image

        Vignette.ImageTransparency =
            SHADER_CONFIG.Vignette.ImageTransparency

        Vignette.ScaleType =
            Enum.ScaleType.Stretch

        Vignette.ZIndex =
            SHADER_CONFIG.Vignette.ZIndex

        Vignette.Parent =
            targetParent
    end
