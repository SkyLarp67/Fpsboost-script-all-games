                        -13
                    ),

                BackgroundColor3 =
                    Color3.fromRGB(
                        42,
                        42,
                        50
                    ),

                BorderSizePixel = 0,

                Text =
                    tostring(
                        SHADER_CONFIG[group][key]
                    ),

                TextColor3 =
                    Color3.fromRGB(
                        245,
                        245,
                        250
                    ),

                TextSize = 10,

                Font =
                    Enum.Font.GothamMedium,

                ClearTextOnFocus = false
            },
            row
        )

    AddCorner(box, 6)

    box.FocusLost:Connect(
        function()

            local number =
                tonumber(box.Text)

            if number then

                if min ~= nil
                and max ~= nil then

                    number =
                        math.clamp(
