        "BloomEnabled",
        "BlurEnabled",
        "ColorCorrectionEnabled",
        "SunRaysEnabled",
        "AtmosphereEnabled",
        "ShaderSkyEnabled",
        "VignetteEnabled"
    }

    for _, key in ipairs(toggles) do

        if type(data[key]) == "boolean" then
            SHADER_CONFIG[key] = data[key]
        end

    end

    local groups = {
        "Bloom",
        "Blur",
        "ColorCorrection",
        "SunRays",
        "Atmosphere",
        "Lighting",
        "Vignette"
    }

    for _, groupName in ipairs(groups) do

        if type(data[groupName]) == "table"
        and type(SHADER_CONFIG[groupName]) == "table" then

            for key, value in pairs(data[groupName]) do

                if type(value) == "number" then
                    SHADER_CONFIG[groupName][key] = value
