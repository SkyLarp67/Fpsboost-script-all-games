local function FindSky(root)

    if not root then
        return nil
    end

    if root:IsA("Sky") then
        return root
    end

    return root:FindFirstChildWhichIsA(
        "Sky",
        true
    )
end

local function CloneSkyProperties(
    sourceSky,
    targetSky
)

    if not sourceSky
    or not targetSky then
        return false
    end

    local properties = {
        "SkyboxBk",
        "SkyboxDn",
        "SkyboxFt",
        "SkyboxLf",
        "SkyboxRt",
        "SkyboxUp",
        "SunAngularSize",
        "SunTextureId",
        "MoonTextureId",
        "MoonAngularSize",
        "StarCount",
        "CelestialBodiesShown"
    }

    for _, property in ipairs(properties) do

        pcall(function()

            local value =
                sourceSky[property]

            if value ~= nil then
                targetSky[property] = value
            end
        end)
    end

    return true
end

local function RemoveCurrentSky()

    pcall(function()

        local selected =
            Lighting:FindFirstChild(
                "SKYLARP_CurrentSky"
            )

        if selected then
            SafeDestroy(selected)
        end

        local shaderSky =
            Lighting:FindFirstChild(
                "CustomSky"
            )

        if shaderSky then
            SafeDestroy(shaderSky)
        end
    end)

    CurrentSky = nil
end

local function LoadSkyAsset(assetId)

    local objects = {}

    pcall(function()

        local container =
            InsertService:LoadAsset(assetId)

        if container then
            table.insert(objects, container)
        end
    end)

    if #objects > 0 then
        return objects
    end

    pcall(function()

        if typeof(game.GetObjects) == "function" then

            local result =
                game:GetObjects(
                    "rbxassetid://"
                    .. tostring(assetId)
                )

            if result then

                for _, object in ipairs(result) do
                    table.insert(objects, object)
                end
            end
        end
    end)

    return objects
end

