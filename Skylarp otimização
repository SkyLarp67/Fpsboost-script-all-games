local function ClampGuidesToScreen(guide)
    if not guide or not guide.Object then return end
    local parentSize = ScreenGui.AbsoluteSize
    local size = guide.Object.AbsoluteSize
    local x = guide.Object.Position.X.Offset
    local y = guide.Object.Position.Y.Offset
    local maxX = math.max(0, parentSize.X - size.X)
    local maxY = math.max(0, parentSize.Y - size.Y)
    guide.X = math.clamp(x, 0, maxX)
    guide.Y = math.clamp(y, 0, maxY)
