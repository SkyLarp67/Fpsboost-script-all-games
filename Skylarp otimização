local function RefreshStretchSlider()

    local alpha =
        (
            StretchValue
            - CONFIG.StretchMin
        )
        /
        (
            CONFIG.StretchMax
            - CONFIG.StretchMin
        )

    alpha =
        math.clamp(
            alpha,
            0,
            1
        )

    StretchFill.Size =
        UDim2.new(
            alpha,
            0,
            1,
            0
        )

    StretchKnob.Position =
        UDim2.new(
            alpha,
            -8,
            0.5,
            -8
        )

    StretchBox.Text =
        string.format(
            "%.2f",
            StretchValue
        )
end

local function SetStretchFromSlider(
    inputX
)

    local left =
        StretchSlider.AbsolutePosition.X

    local width =
        StretchSlider.AbsoluteSize.X

    if width <= 0 then
        return
    end

    local alpha =
        math.clamp(
            (inputX - left) / width,
            0,
            1
        )

    local value =
        CONFIG.StretchMin
        +
        (
            CONFIG.StretchMax
            - CONFIG.StretchMin
        )
        * alpha

    SetStretchValue(value)

    RefreshStretchSlider()
end

--==================================================--
-- STRETCH TOUCH CORRIGIDO
--==================================================--

StretchSlider.InputBegan:Connect(
    function(input)

        if input.UserInputType ==
            Enum.UserInputType.Touch
            or input.UserInputType ==
            Enum.UserInputType.MouseButton1 then

            StretchDragging = true
            StretchDragInput = input

            SetStretchFromSlider(
                input.Position.X
            )
        end
    end
)

UserInputService.InputChanged:Connect(
    function(input)

        if not StretchDragging then
            return
        end

        if not StretchSlider.Visible then
            StopStretchDragging()
            return
        end

        -- TOUCH:
        -- somente o mesmo dedo que iniciou o slider
        if StretchDragInput
        and StretchDragInput.UserInputType ==
            Enum.UserInputType.Touch then

            if input ~= StretchDragInput then
                return
            end

            SetStretchFromSlider(
                input.Position.X
            )

            return
        end

        -- MOUSE:
        if StretchDragInput
        and StretchDragInput.UserInputType ==
            Enum.UserInputType.MouseButton1 then

            if input.UserInputType ==
                Enum.UserInputType.MouseMovement then

                SetStretchFromSlider(
                    input.Position.X
                )
            end
        end
    end
)

UserInputService.InputEnded:Connect(
    function(input)

        if input == StretchDragInput
        or (
            StretchDragInput
            and StretchDragInput.UserInputType ==
                Enum.UserInputType.MouseButton1
            and input.UserInputType ==
                Enum.UserInputType.MouseButton1
        ) then

            StopStretchDragging()
        end
    end
)

StretchBox.Focused:Connect(function()
    StopStretchDragging()
end)

StretchBox.FocusLost:Connect(
    function()

        StopStretchDragging()

        if SetStretchValue(
            StretchBox.Text
        ) then

            RefreshStretchSlider()

        else

            RefreshStretchSlider()
        end
    end
)

StretchToggle.Activated:Connect(
    function()

        StopStretchDragging()

        SetStretchEnabled(
            not StretchEnabled
        )

        StretchToggle.Text =
            StretchEnabled
            and "STRETCH SCREEN: ON"
            or "STRETCH SCREEN: OFF"
    end
)

RefreshStretchSlider()

