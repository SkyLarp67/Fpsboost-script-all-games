local function ApplyHDLight()
    local L = SHADER_CONFIG.Light
    if SHADER_CONFIG.LightEnabled then
        if SHADER_CONFIG.LightColorEnabled then
            SafeSet(Lighting, "Ambient", RGB(L.R, L.G, L.B))
            SafeSet(Lighting, "OutdoorAmbient", RGB(L.R, L.G, L.B))
        else
            SafeSet(Lighting, "Ambient", ShaderOriginal.Ambient)
            SafeSet(Lighting, "OutdoorAmbient", ShaderOriginal.OutdoorAmbient)
        end
        SafeSet(Lighting, "Brightness", SHADER_CONFIG.Lighting.Brightness)
    else
        SafeSet(Lighting, "Ambient", Color3.fromRGB(0, 0, 0))
        SafeSet(Lighting, "OutdoorAmbient", Color3.fromRGB(0, 0, 0))
        SafeSet(Lighting, "Brightness", 0)
    end
end

local function ApplyShaderLighting()
    CaptureLighting()
    local L = SHADER_CONFIG.Lighting
    ApplyHDLight()
    SafeSet(Lighting, "EnvironmentDiffuseScale", L.EnvironmentDiffuseScale)
    SafeSet(Lighting, "EnvironmentSpecularScale", L.EnvironmentSpecularScale)
    SafeSet(Lighting, "GlobalShadows", L.GlobalShadows)
    SafeSet(Lighting, "ShadowSoftness", L.ShadowSoftness)
    SafeSet(Lighting, "ClockTime", L.ClockTime)
    SafeSet(Lighting, "GeographicLatitude", L.GeographicLatitude)
    SafeSet(Lighting, "ExposureCompensation", L.ExposureCompensation)
end

local function ApplyShaders()
    RemoveShaderEffects()
    if not SHADER_CONFIG.Enabled then return end
    CaptureLighting()
    if SHADER_CONFIG.BloomEnabled then
        local Bloom = Instance.new("BloomEffect")
        Bloom.Name = "CustomBloom"
        Bloom.Intensity = SHADER_CONFIG.Bloom.Intensity
        Bloom.Size = SHADER_CONFIG.Bloom.Size
        Bloom.Threshold = SHADER_CONFIG.Bloom.Threshold
        Bloom.Parent = Lighting
    end
    if SHADER_CONFIG.BlurEnabled then
        local Blur = Instance.new("BlurEffect")
        Blur.Name = "CustomBlur"
        Blur.Size = SHADER_CONFIG.Blur.Size
        Blur.Parent = Lighting
    end
    if SHADER_CONFIG.ColorCorrectionEnabled then
        local ColorCor = Instance.new("ColorCorrectionEffect")
        ColorCor.Name = "CustomColor"
