local function RestoreSelectedSky()

    if not SkySelected then
        return
    end

    for _, skyInfo in ipairs(SKY_LIST) do

        if skyInfo.Name == SkySelected then

            task.spawn(function()

                ApplySky(
                    skyInfo,
                    function(message)

                        if SkyStatus then
                            SkyStatus.Text =
                                message
                        end

                    end
                )

            end)

            break
        end

    end
end

local function SetupCharacter(
    character
)

    DisconnectList(
        CharacterConnections
    )

    if not character then
        return
    end

    task.defer(
        function()

            pcall(function()

                for _, object in ipairs(
                    character:GetDescendants()
                ) do

                    ApplyPerformanceObject(
                        object
                    )

                end

            end)

        end
    )

    CharacterConnections.DescendantAdded =
        character.DescendantAdded:Connect(
            function(object)

                task.defer(
                    function()

                        ApplyPerformanceObject(
                            object
                        )

                    end
                )

            end
        )
end

if LocalPlayer.Character then

    SetupCharacter(
        LocalPlayer.Character
    )

end

LocalPlayer.CharacterAdded:Connect(
    function(character)

        task.wait(0.2)

        SetupCharacter(character)

        -- Reaplica o céu escolhido após morrer
        task.delay(
            0.7,
            function()

                RestoreSelectedSky()

            end
        )

        -- Reaplica HD Graphics
        task.delay(
            1.0,
            function()

                if SHADER_CONFIG.Enabled then
                    ApplyShaders()
                end

            end
        )

    end
)

