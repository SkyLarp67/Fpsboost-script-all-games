        if input.UserInputType ~= Enum.UserInputType.Touch and input.UserInputType ~= Enum.UserInputType.MouseButton1 then return end
        dragTarget = ImageGuide.Selected.Object
        dragInput = input
        dragStart = input.Position
        startPos = Vector2.new(dragTarget.Position.X.Offset, dragTarget.Position.Y.Offset)
    end)
    dragHandle.InputEnded:Connect(function(input)
        if input == dragInput then
            dragTarget = nil
            dragInput = nil
            SaveImageGuides()
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragTarget and dragInput and input == dragInput then dragObject(input) end
        if resizing and sizeStart and input.UserInputType == Enum.UserInputType.MouseMovement then resizeObject(input) end
    end)

    local resizeHandle = Create("TextButton", {Size = UDim2.fromOffset(18,18), Position = UDim2.fromOffset(0,0), BackgroundColor3 = Color3.fromRGB(220,220,230), BorderSizePixel = 0, Text = "", Visible = false, ZIndex = 1002}, ImageGuidePanel)
    AddCorner(resizeHandle, 9)
    resizeHandle.InputBegan:Connect(function(input)
        if not ImageGuide.Selected then return end
        if input.UserInputType ~= Enum.UserInputType.Touch and input.UserInputType ~= Enum.UserInputType.MouseButton1 then return end
        resizing = true
        sizeStart = input.Position
        startSize = Vector2.new(ImageGuide.Selected.Object.Size.X.Offset, ImageGuide.Selected.Object.Size.Y.Offset)
    end)
    resizeHandle.InputEnded:Connect(function(input)
        if resizing then resizing = false; SaveImageGuides() end
    end)

    local function SyncHandlePositions()
        if not ImageGuide.Selected or not ImageGuide.Selected.Object then
            dragHandle.Visible = false
            resizeHandle.Visible = false
            return
        end
        local obj = ImageGuide.Selected.Object
        local absPos = obj.AbsolutePosition
        dragHandle.Position = UDim2.fromOffset(absPos.X - ImageGuidePanel.AbsolutePosition.X + 8, absPos.Y - ImageGuidePanel.AbsolutePosition.Y + 8)
        resizeHandle.Position = UDim2.fromOffset(absPos.X - ImageGuidePanel.AbsolutePosition.X + obj.AbsoluteSize.X - 9, absPos.Y - ImageGuidePanel.AbsolutePosition.Y + obj.AbsoluteSize.Y - 9)
        dragHandle.Visible = true
        resizeHandle.Visible = true
    end
    task.spawn(function()
        while true do
            if ImageGuidePanel.Visible then SyncHandlePositions() end
            task.wait(0.05)
        end
    end)

    ImageGuidePanel:WaitForChild("GuideTitle")
    title = ImageGuidePanel.GuideTitle
end

