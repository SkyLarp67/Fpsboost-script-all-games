--==================================================--

local StretchConnection = nil

-- CORREÇÃO DO SLIDER
local StretchDragging = false
local StretchDragInput = nil

local function StopStretchDragging()

    StretchDragging = false
    StretchDragInput = nil

end

local function DisconnectStretch()

    if StretchConnection then

        pcall(function()
            StretchConnection:Disconnect()
        end)

        StretchConnection = nil
    end
end

local function ApplyRealStretch()

    if not StretchEnabled then
        return
    end

    local Camera =
        Workspace.CurrentCamera

    if not Camera then
        return
    end

    local scale =
        math.clamp(
            StretchValue,
            CONFIG.StretchMin,
            CONFIG.StretchMax
        )

    pcall(function()

        Camera.CFrame =
            Camera.CFrame
            * CFrame.new(
                0,
                0,
                0,
                1, 0, 0,
                0, scale, 0,
                0, 0, 1
            )
    end)
end

local function SetStretchEnabled(enabled)

    StretchEnabled = enabled == true

    DisconnectStretch()

    if StretchEnabled then

        StretchConnection =
            RunService.RenderStepped:Connect(
                ApplyRealStretch
            )
    end

    SaveSettings()
end

local function SetStretchValue(value)

    local number = tonumber(value)

    if not number then
        return false
    end

    StretchValue =
        math.clamp(
            number,
            CONFIG.StretchMin,
            CONFIG.StretchMax
        )

    SaveSettings()

    return true
end

