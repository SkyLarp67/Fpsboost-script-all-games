local function RefreshStretchSlider()

    local alpha =
        (
            StretchValue
            - CONFIG.StretchMin
        )
        /
        (
            CONFIG.StretchMax
            - CONFIG.StretchMin
        )

    alpha =
        math.clamp(
            alpha,
            0,
            1
        )

    StretchFill.Size =
        UDim2.new(
            alpha,
            0,
            1,
            0
        )

    StretchKnob.Position =
        UDim2.new(
            alpha,
            -8,
            0.5,
            -8
        )

    StretchBox.Text =
        string.format(
            "%.2f",
            StretchValue
        )
end

local function SetStretchFromSlider(
    inputX
)

    local left =
        StretchSlider.AbsolutePosition.X

    local width =
        StretchSlider.AbsoluteSize.X

    if width <= 0 then
        return
    end

    local alpha =
        math.clamp(
            (inputX - left) / width,
            0,
            1
        )

    local value =
        CONFIG.StretchMin
        +
        (
            CONFIG.StretchMax
            - CONFIG.StretchMin
        )
        * alpha

    SetStretchValue(value)

    RefreshStretchSlider()
end

StretchSlider.InputBegan:Connect(
    function(input)

        if input.UserInputType ==
            Enum.UserInputType.Touch
            or input.UserInputType ==
            Enum.UserInputType.MouseButton1 then

            SetStretchFromSlider(
                input.Position.X
            )

        end

    end
)

UserInputService.InputChanged:Connect(
    function(input)

        if input.UserInputType ==
            Enum.UserInputType.Touch
            or input.UserInputType ==
            Enum.UserInputType.MouseMovement then

            if UserInputService:IsMouseButtonPressed(
                Enum.UserInputType.MouseButton1
            ) then

                if StretchSlider.Visible then

                    local p =
                        input.Position

                    local pos =
                        StretchSlider.AbsolutePosition

                    local size =
                        StretchSlider.AbsoluteSize

                    if p.X >= pos.X
                    and p.X <= pos.X + size.X
                    and p.Y >= pos.Y - 20
                    and p.Y <= pos.Y + size.Y + 20 then

                        SetStretchFromSlider(
                            p.X
                        )

                    end

                end

            end

        end

    end
)

StretchBox.FocusLost:Connect(
    function()

        if SetStretchValue(
            StretchBox.Text
        ) then

            RefreshStretchSlider()

        else

            RefreshStretchSlider()

        end

    end
)

StretchToggle.Activated:Connect(
    function()

        SetStretchEnabled(
            not StretchEnabled
        )

        StretchToggle.Text =
            StretchEnabled
            and "STRETCH SCREEN: ON"
            or "STRETCH SCREEN: OFF"

    end
)

RefreshStretchSlider()

