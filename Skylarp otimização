local function Create(
    className,
    properties,
    parent
)

    local object =
        Instance.new(className)

    for property, value in pairs(
        properties or {}
    ) do

        pcall(function()

            object[property] =
                value

        end)

    end

    if parent then
        object.Parent = parent
    end

    return object
end

local function AddCorner(
    object,
    radius
)

    return Create(
        "UICorner",
        {
            CornerRadius =
                UDim.new(
                    0,
                    radius or 8
                )
        },
        object
    )
end

local function AddStroke(
    object,
    transparency
)

    return Create(
        "UIStroke",
        {
            Thickness = 1,
            Transparency =
                transparency or 0.35
        },
        object
    )
end

local function MakeButton(
    parent,
    text,
    size,
    position
)

    local button =
        Create(
            "TextButton",
            {
                Size = size,
                Position = position,

                BackgroundColor3 =
                    Color3.fromRGB(
                        38,
                        38,
                        44
                    ),

                BorderSizePixel = 0,

                Text = text,

                TextColor3 =
                    Color3.fromRGB(
                        235,
                        235,
                        240
                    ),

                TextSize = 13,

                Font =
                    Enum.Font.GothamMedium,

                AutoButtonColor = true,

                Active = true
            },
            parent
        )

    AddCorner(
        button,
        8
    )

    AddStroke(
        button,
        0.55
    )

    return button
end

