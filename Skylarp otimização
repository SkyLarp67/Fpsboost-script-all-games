local function SetPerformanceOption(
    option,
    enabled
)

    if CONFIG.Performance[option] == nil then
        return
    end

    CONFIG.Performance[option] =
        enabled

    if enabled then

        task.spawn(function()

            pcall(
                ScanWorkspaceOnce
            )

        end)

    end

    SaveSettings()
end

local function CreateToggle(
    parent,
    text,
    option,
    layoutOrder
)

    local row =
        Create(
            "TextButton",
            {
                Size =
                    UDim2.new(
                        1,
                        -20,
                        0,
                        31
                    ),

                BackgroundColor3 =
                    Color3.fromRGB(
                        31,
                        31,
                        37
                    ),

                BorderSizePixel = 0,

                Text = "",

                LayoutOrder =
                    layoutOrder,

                Active = true
            },
            parent
        )

    AddCorner(
        row,
        7
    )

    Create(
        "TextLabel",
        {
            Size =
                UDim2.new(
                    1,
                    -70,
                    1,
                    0
                ),

            Position =
                UDim2.fromOffset(
                    12,
                    0
                ),

            BackgroundTransparency = 1,

            Text = text,

            TextColor3 =
                Color3.fromRGB(
                    225,
                    225,
                    230
                ),

            TextSize = 11,

            Font =
                Enum.Font.GothamMedium,

            TextXAlignment =
                Enum.TextXAlignment.Left
        },
        row
    )

    local state =
        Create(
            "TextLabel",
            {
                Size =
                    UDim2.fromOffset(
                        48,
                        23
                    ),

                Position =
                    UDim2.new(
                        1,
                        -56,
                        0.5,
                        -11
                    ),

                TextSize = 9,

                Font =
                    Enum.Font.GothamBold
            },
            row
        )

    AddCorner(
        state,
        6
    )

    local function Refresh()

        local enabled =
            CONFIG.Performance[option]

        if enabled then

            state.Text = "ON"

            state.BackgroundColor3 =
                Color3.fromRGB(
                    65,
                    120,
                    80
                )

            state.TextColor3 =
                Color3.fromRGB(
                    255,
                    255,
                    255
                )

        else

            state.Text = "OFF"

            state.BackgroundColor3 =
                Color3.fromRGB(
                    60,
                    60,
                    68
                )

            state.TextColor3 =
                Color3.fromRGB(
                    185,
                    185,
                    190
                )

        end

    end

    row.Activated:Connect(function()

        SetPerformanceOption(
            option,
            not CONFIG.Performance[option]
        )

        Refresh()

    end)

    Refresh()

    return row
end

