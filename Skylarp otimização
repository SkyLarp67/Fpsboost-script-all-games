--==================================================--
-- FPS
--==================================================--

local FPSFrames = 0

local FPSAccumulator = 0

RunService.RenderStepped:Connect(
    function(deltaTime)

        if not deltaTime
            or deltaTime <= 0 then

            return
        end

        FPSFrames += 1

        FPSAccumulator +=
            deltaTime

        if FPSAccumulator >= 0.5 then

            local fps =
                FPSFrames
                / FPSAccumulator

            if fps == fps
                and fps > 0 then

                FPSLabel.Text =
                    "FPS: "
                    .. tostring(
                        math.floor(
                            fps + 0.5
                        )
                    )

            end

            FPSFrames = 0

            FPSAccumulator = 0

        end

    end
)

