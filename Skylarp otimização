local InterfaceScales = {}
for _, object in ipairs(InterfaceObjects) do
    local scaleObject = Instance.new("UIScale")
    scaleObject.Scale = 1
    scaleObject.Parent = object
    InterfaceScales[object] = scaleObject
end

local function UpdateInterfaceScale()

    local viewport = Vector2.new(0, 0)
    pcall(function()
        viewport = Workspace.CurrentCamera.ViewportSize
    end)

    local effective = InterfaceScale

    if InterfaceAutoFit and viewport.X > 0 and viewport.Y > 0 then
        -- O maior painel é o HD Graphics (310x500).
        local fitX = (viewport.X - 12) / 310
        local fitY = (viewport.Y - 12) / 500
        effective = math.min(effective, fitX, fitY)
    end

    effective = math.clamp(effective, 0.55, 1.30)

    for object, scaleObject in pairs(InterfaceScales) do
        if object and object.Parent then
            scaleObject.Scale = effective
        end
    end

    InterfaceSizeLabel.Text =
        "TAMANHO DA GUI: " .. tostring(math.floor(InterfaceScale * 100 + 0.5)) .. "%"

    AutoFitButton.Text = InterfaceAutoFit and "AUTO: ON" or "AUTO: OFF"
end

ClampInterfaceObject = function(object)

    if not object or not object.Parent or not object.Visible then
        return
    end

    local viewport = Vector2.new(0, 0)
    pcall(function()
        viewport = Workspace.CurrentCamera.ViewportSize
    end)

    if viewport.X <= 0 or viewport.Y <= 0 then
        return
    end

    local size = object.AbsoluteSize
    local parent = object.Parent

    -- Partes dentro de outro Frame devem ficar dentro do próprio Frame.
    if parent and parent:IsA("GuiObject") then
        local parentSize = parent.AbsoluteSize
        local parentScale = 1
        local parentUIScale = parent:FindFirstChildOfClass("UIScale")
        if parentUIScale then parentScale = math.max(0.01, parentUIScale.Scale) end

        local maxX = math.max(0, (parentSize.X - size.X) / parentScale)
        local maxY = math.max(0, (parentSize.Y - size.Y) / parentScale)
        object.Position = UDim2.fromOffset(
            math.clamp(object.Position.X.Offset, 0, maxX),
            math.clamp(object.Position.Y.Offset, 0, maxY)
        )
        return
    end

    local maxX = math.max(0, viewport.X - size.X - 2)
    local maxY = math.max(0, viewport.Y - size.Y - 2)

    object.Position = UDim2.fromOffset(
        math.clamp(object.Position.X.Offset, 2, maxX),
        math.clamp(object.Position.Y.Offset, 2, maxY)
    )
end

local function ClampAllInterface()
    for _, object in ipairs(InterfaceObjects) do
        ClampInterfaceObject(object)
    end
end

local function CaptureInterfacePart(id)
    local obj = InterfaceParts[id]
    if not obj then return end
    InterfacePartSettings[id] = {
        SizeX=obj.Size.X.Offset, SizeY=obj.Size.Y.Offset,
        PosX=obj.Position.X.Offset, PosY=obj.Position.Y.Offset,
        BackgroundColor=Color3ToTable(obj.BackgroundColor3),
        TextColor=Color3ToTable(GetGuiTextColor(obj)),
        BackgroundTransparency=obj.BackgroundTransparency
    }
end

local function CaptureAllInterfaceParts()
    for id in pairs(InterfaceParts) do CaptureInterfacePart(id) end
end

local function ApplyEditorDelta(dx, dy, dw, dh)
    local obj = InterfaceParts[SelectedInterfacePartID]
    if not obj then return end
    local minW, minH = 40, 25
    local newW = math.max(minW, obj.Size.X.Offset + (dw or 0))
    local newH = math.max(minH, obj.Size.Y.Offset + (dh or 0))
    obj.Size = UDim2.fromOffset(newW, newH)
    obj.Position = UDim2.fromOffset(obj.Position.X.Offset + (dx or 0), obj.Position.Y.Offset + (dy or 0))
    ClampInterfaceObject(obj)
    CaptureInterfacePart(SelectedInterfacePartID)
    RefreshEditorValues()
    SaveSettings()
end

