        Sky.SunAngularSize =
            SHADER_CONFIG.ShaderSky.SunAngularSize

        Sky.Parent = Lighting
    end

    --================================================--
    -- LIGHTING
    --==================================================

    ApplyShaderLighting()

    --================================================--
    -- VIGNETTE
    --==================================================

    if SHADER_CONFIG.VignetteEnabled then

        local targetParent = ScreenGui

        if not targetParent then
            targetParent = CoreGui
        end

        local Vignette =
            Instance.new("ImageLabel")

        Vignette.Name =
            "CustomVignette"

        Vignette.Size =
