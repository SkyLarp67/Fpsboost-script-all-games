--==================================================--
-- SAFE FUNCTIONS
--==================================================--

local function SafeSet(object, property, value)
    if not object then
        return false
    end

    return pcall(function()
        object[property] = value
    end)
end

local function SafeGet(object, property)
    if not object then
        return nil
    end

    local value

    pcall(function()
        value = object[property]
    end)

    return value
end

local function SafeDestroy(object)
    if not object then
        return
    end

    pcall(function()
        object:Destroy()
    end)
end

local function ClampNumber(value, min, max, default)
    local number = tonumber(value)

    if not number then
        number = default
    end

    if min and max then
        number = math.clamp(number, min, max)
    end

    return number
end

local function RGB(r, g, b)
    return Color3.fromRGB(
        math.clamp(tonumber(r) or 0, 0, 255),
        math.clamp(tonumber(g) or 0, 0, 255),
        math.clamp(tonumber(b) or 0, 0, 255)
    )
end

local function Color3ToTable(color)
    if typeof(color) ~= "Color3" then return nil end
    return {
        R = math.floor(color.R * 255 + 0.5),
        G = math.floor(color.G * 255 + 0.5),
        B = math.floor(color.B * 255 + 0.5)
    }
end

local function TableToColor3(t)
    if type(t) ~= "table" then return nil end
    return Color3.fromRGB(
        math.clamp(tonumber(t.R) or 255,0,255),
        math.clamp(tonumber(t.G) or 255,0,255),
        math.clamp(tonumber(t.B) or 255,0,255)
    )
end

local function GetGuiTextColor(object)
    if not object then return nil end
    local ok, value = pcall(function() return object.TextColor3 end)
    return ok and value or nil
end

