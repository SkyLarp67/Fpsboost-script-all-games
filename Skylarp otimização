local function InterfaceGetViewport()
    local camera = Workspace.CurrentCamera
    if camera then
        local size = camera.ViewportSize
        if size.X > 0 and size.Y > 0 then
            return size
        end
    end

    return Vector2.new(800, 600)
end

local function InterfaceGetParentSize(object)
    if object.Parent and object.Parent:IsA("GuiObject") then
        return object.Parent.AbsoluteSize
    end

    return InterfaceGetViewport()
end

local function InterfaceClampObject(object)
    if not object or not object.Parent then
        return
    end

    local parent = object.Parent
    local parentSize = InterfaceGetParentSize(object)
    if parentSize.X <= 0 or parentSize.Y <= 0 then
        return
    end

    local size = object.AbsoluteSize
    local anchorX = object.AnchorPoint.X
    local anchorY = object.AnchorPoint.Y

    -- Sempre trabalha em pixels para impedir que o objeto escape.
    local currentX = parentSize.X * object.Position.X.Scale + object.Position.X.Offset
    local currentY = parentSize.Y * object.Position.Y.Scale + object.Position.Y.Offset

    -- Se o elemento for maior que o pai, primeiro reduzimos o tamanho.
    -- Isso evita o caso em que o objeto fica impossível de enquadrar.
    local maxWidth = math.max(8, parentSize.X - 4)
    local maxHeight = math.max(8, parentSize.Y - 4)

    if size.X > maxWidth or size.Y > maxHeight then
        local newW = math.min(size.X, maxWidth)
        local newH = math.min(size.Y, maxHeight)
        object.Size = UDim2.fromOffset(newW, newH)
        size = object.AbsoluteSize
    end

    -- Limites exatos para o AnchorPoint.
    local minX = size.X * anchorX + 2
    local maxX = parentSize.X - size.X * (1 - anchorX) - 2
    local minY = size.Y * anchorY + 2
    local maxY = parentSize.Y - size.Y * (1 - anchorY) - 2

    -- Por segurança, se a resolução for muito pequena, centraliza.
    if maxX < minX then
        minX = parentSize.X * 0.5
        maxX = minX
    end
    if maxY < minY then
        minY = parentSize.Y * 0.5
        maxY = minY
    end

    local finalX = math.clamp(currentX, minX, maxX)
    local finalY = math.clamp(currentY, minY, maxY)

    object.Position = UDim2.new(
        0, math.floor(finalX + 0.5),
        0, math.floor(finalY + 0.5)
    )
end

local function InterfaceClampAll()
    for _, object in pairs(InterfaceObjects) do
        pcall(function()
            InterfaceClampObject(object)
        end)
    end
end

local InterfaceApplyImage
local InterfaceApplySavedImage

local function InterfaceApplySaved()
    InterfaceApplying = true

    for id, object in pairs(InterfaceObjects) do
        local data = InterfaceSettings[id]

        if type(data) == "table" then
            pcall(function()
                if type(data.Size) == "table" then
                    object.Size = InterfaceUDim2(data.Size, object.Size)
                end

                if type(data.Position) == "table" then
                    object.Position = InterfaceUDim2(data.Position, object.Position)
                end

                InterfaceApplySavedImage(id, object, data)
            end)
        end
    end

    task.defer(function()
        InterfaceClampAll()
        InterfaceApplying = false
    end)
end

local function InterfaceSaveObject(id, object)
    if not id or not object then
        return
    end

    local previous = InterfaceSettings[id]
    InterfaceSettings[id] = {
        Size = InterfaceCopyUDim2(object.Size),
        Position = InterfaceCopyUDim2(object.Position),
        Image = type(previous) == "table" and previous.Image or ""
    }
end

local function InterfaceResetObject(id)
    local object = InterfaceObjects[id]
    local default = InterfaceDefaults[id]

    if not object or not default then
        return
    end

    InterfaceApplying = true

    pcall(function()
        object.Size = InterfaceUDim2(default.Size, object.Size)
        object.Position = InterfaceUDim2(default.Position, object.Position)
    end)

    InterfaceSettings[id] = nil

    local customImageName = "SKYLARP_CustomImage_" .. tostring(id):gsub("[^%w_]", "_")
    pcall(function()
        local image = object:FindFirstChild(customImageName)
        if image then image:Destroy() end
        if object:IsA("ImageLabel") or object:IsA("ImageButton") then
            object.Image = ""
        end
    end)

    task.defer(function()
        InterfaceClampObject(object)
        InterfaceApplying = false
        SaveSettings()
    end)
end

local function InterfaceResetAll()
    InterfaceApplying = true

    for id, object in pairs(InterfaceObjects) do
        local default = InterfaceDefaults[id]

        if default then
            pcall(function()
                object.Size = InterfaceUDim2(default.Size, object.Size)
                object.Position = InterfaceUDim2(default.Position, object.Position)
            end)
        end
    end

    InterfaceSettings = {}
    task.defer(function()
        InterfaceClampAll()
        InterfaceApplying = false
        SaveSettings()
    end)
end

