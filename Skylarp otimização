--==================================================--
-- FUNÇÕES AUXILIARES
--==================================================--

RGBToHex = function(r, g, b)
    return string.format(
        "#%02X%02X%02X",
        math.clamp(math.floor(tonumber(r) or 0), 0, 255),
        math.clamp(math.floor(tonumber(g) or 0), 0, 255),
        math.clamp(math.floor(tonumber(b) or 0), 0, 255)
    )
end

ColorToHex = function(color)
    if not color then
        return "#FFFFFF"
    end

    return RGBToHex(
        math.floor(color.R * 255 + 0.5),
        math.floor(color.G * 255 + 0.5),
        math.floor(color.B * 255 + 0.5)
    )
end

GetLightColor = function()
    return RGB(
        SHADER_CONFIG.Light.R,
        SHADER_CONFIG.Light.G,
        SHADER_CONFIG.Light.B
    )
end

ApplySelectedLightColor = function()
    if SHADER_CONFIG.Enabled
    and SHADER_CONFIG.LightEnabled
    and SHADER_CONFIG.LightColorEnabled then
        ApplyHDLight()
    end

    SaveSettings()
end

