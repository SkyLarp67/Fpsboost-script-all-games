                        240
                    ),

                TextSize = 13,

                Font =
                    Enum.Font.GothamMedium,

                AutoButtonColor = true,

                Active = true
            },
            parent
        )

    AddCorner(button, 8)
    AddStroke(button, 0.55)

    return button
end

