local function ApplyNoCameraEffects()

    if not CONFIG.Performance.NoCameraEffects then
        return
    end

    pcall(function()

        for _, object in ipairs(Lighting:GetChildren()) do

            if object:IsA("PostEffect")
            and not IsSKYLARPEffect(object) then

                SafeDestroy(object)
            end
        end
    end)
end

--==================================================--
-- PERFORMANCE FUNCTIONS
--==================================================--

local function ApplyNoClothes(object)

    if not CONFIG.Performance.NoClothes then
        return
    end

    if not object then
        return
    end

    pcall(function()

        if object:IsA("Shirt")
        or object:IsA("Pants")
        or object:IsA("ShirtGraphic")
        or object:IsA("CharacterMesh") then

            SafeDestroy(object)
            return
        end

        if object:IsA("Accessory")
        and IsCharacterPart(object) then

            SafeDestroy(object)
        end
    end)
end

local function ApplyLowWater(object)

    if not CONFIG.Performance.LowWaterGraphics then
        return
    end

    if not object then
        return
    end

    pcall(function()

        if object:IsA("Terrain") then

            SafeSet(object, "WaterWaveSize", 0)
            SafeSet(object, "WaterWaveSpeed", 0)
            SafeSet(object, "WaterReflectance", 0)
            SafeSet(object, "WaterTransparency", 1)

        end
    end)
end

local function ApplyNoShadows(object)

    if not CONFIG.Performance.NoShadows then
        return
    end

    if not object then
        return
    end

    pcall(function()

        if object:IsA("BasePart") then
            SafeSet(object, "CastShadow", false)
        end
    end)
end

local function ApplyLowRendering()

    if not CONFIG.Performance.LowRendering then
        return
    end

    pcall(function()
        settings().Rendering.QualityLevel =
            Enum.QualityLevel.Level01
    end)

    if not SHADER_CONFIG.Enabled then

        pcall(function()
            Lighting.GlobalShadows = false
        end)
    end
end

local function ApplyLowQualityParts(object)

    if not CONFIG.Performance.LowQualityParts then
        return
    end

    if not object then
        return
    end

    pcall(function()

        if object:IsA("BasePart") then

            SafeSet(object, "Reflectance", 0)
            SafeSet(
                object,
                "Material",
                Enum.Material.SmoothPlastic
            )

            if object:IsA("MeshPart") then

                SafeSet(
                    object,
                    "RenderFidelity",
                    Enum.RenderFidelity.Performance
                )
            end
        end
    end)
end

local function ApplyLowQualityModels(object)

    if not CONFIG.Performance.LowQualityModels then
        return
    end

    if not object then
        return
    end

    pcall(function()

        if object:IsA("MeshPart") then

            SafeSet(
                object,
                "RenderFidelity",
                Enum.RenderFidelity.Performance
            )

        elseif object:IsA("BasePart") then

            SafeSet(
                object,
                "CastShadow",
                false
            )
        end
    end)
end

local function ApplyResetMaterials(object)

    if not CONFIG.Performance.ResetMaterials then
        return
    end

    if not object then
        return
    end

    pcall(function()

        if object:IsA("BasePart") then

            SafeSet(
                object,
                "Material",
                Enum.Material.SmoothPlastic
            )

            SafeSet(
                object,
                "Reflectance",
                0
            )
        end
    end)
end

local function ApplyRemoveParticles(object)

    if not CONFIG.Performance.RemoveParticles then
        return
    end

    if not object then
        return
    end

    pcall(function()

        if object:IsA("ParticleEmitter")
        or object:IsA("Trail")
        or object:IsA("Beam")
        or object:IsA("Smoke")
        or object:IsA("Fire")
        or object:IsA("Sparkles") then

            SafeDestroy(object)
        end
    end)
end

local function ApplyRemoveLights(object)

    if not CONFIG.Performance.RemoveLights then
        return
    end

    if not object then
        return
    end

    pcall(function()

        if object:IsA("PointLight")
        or object:IsA("SpotLight")
        or object:IsA("SurfaceLight") then

            SafeDestroy(object)
        end
    end)
end

local function ApplyRemoveClouds(object)

    if not CONFIG.Performance.RemoveClouds then
        return
    end

    if not object then
        return
    end

    pcall(function()

        if object:IsA("Clouds") then
            SafeDestroy(object)
        end
    end)
end

local function RemoveAllClouds()

    if not CONFIG.Performance.RemoveClouds then
        return
    end

    pcall(function()

        for _, object in ipairs(
            Workspace:GetDescendants()
        ) do

            if object:IsA("Clouds") then
                SafeDestroy(object)
            end
        end
    end)

    pcall(function()

        local terrain =
            Workspace:FindFirstChildOfClass("Terrain")

        if terrain then

            for _, object in ipairs(
                terrain:GetChildren()
            ) do

                if object:IsA("Clouds") then
                    SafeDestroy(object)
                end
            end
        end
    end)
end

local function ApplyPerformanceObject(object)

    if not object
    or not object.Parent then
        return
    end

    ApplyNoClothes(object)
    ApplyNoShadows(object)
    ApplyLowQualityParts(object)
    ApplyLowQualityModels(object)
    ApplyResetMaterials(object)
    ApplyRemoveParticles(object)
    ApplyRemoveLights(object)
    ApplyRemoveClouds(object)
end

local function ScanWorkspaceOnce()

    pcall(function()

        for _, object in ipairs(
            Workspace:GetDescendants()
        ) do

            ApplyPerformanceObject(object)
        end
    end)

    ApplyNoCameraEffects()
    ApplyLowRendering()

    ApplyLowWater(
        Workspace:FindFirstChildOfClass("Terrain")
    )

    RemoveAllClouds()
end

local function SetupPerformanceConnections()

    DisconnectList(
        PerformanceConnections
    )

    PerformanceConnections.DescendantAdded =
        Workspace.DescendantAdded:Connect(
            function(object)

                task.defer(function()

                    if object
                    and object.Parent then

                        ApplyPerformanceObject(object)
                    end
                end)
            end
        )

    PerformanceConnections.LightingAdded =
        Lighting.ChildAdded:Connect(
            function(object)

                task.defer(function()

                    ApplyNoCameraEffects()

                    if object then
                        ApplyRemoveLights(object)
                    end
                end)
            end
        )
end

