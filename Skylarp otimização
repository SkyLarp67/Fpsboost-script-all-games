            SafeDestroy(object)
        end
    end)
end

local function ApplyRemoveClouds(object)

    if not CONFIG.Performance.RemoveClouds then
        return
    end

    if not object then
        return
    end

    pcall(function()

        if object:IsA("Clouds") then
            SafeDestroy(object)
        end
    end)
end

local function RemoveAllClouds()

    if not CONFIG.Performance.RemoveClouds then
        return
    end

    pcall(function()

        for _, object in ipairs(
            Workspace:GetDescendants()
        ) do

            if object:IsA("Clouds") then
                SafeDestroy(object)
            end
        end
    end)

    pcall(function()

        local terrain =
            Workspace:FindFirstChildOfClass("Terrain")

        if terrain then

            for _, object in ipairs(
                terrain:GetChildren()
            ) do

                if object:IsA("Clouds") then
                    SafeDestroy(object)
                end
            end
        end
    end)
end

local function ApplyPerformanceObject(object)

    if not object
    or not object.Parent then
        return
    end

    ApplyNoClothes(object)
    ApplyNoShadows(object)
    ApplyLowQualityParts(object)
    ApplyLowQualityModels(object)
    ApplyResetMaterials(object)
    ApplyRemoveParticles(object)
    ApplyRemoveLights(object)
    ApplyRemoveClouds(object)
end

local function ScanWorkspaceOnce()

    pcall(function()

        for _, object in ipairs(
            Workspace:GetDescendants()
        ) do

            ApplyPerformanceObject(object)
        end
    end)

    ApplyNoCameraEffects()
    ApplyLowRendering()

    ApplyLowWater(
        Workspace:FindFirstChildOfClass("Terrain")
    )

    RemoveAllClouds()
end

local function SetupPerformanceConnections()

    DisconnectList(
        PerformanceConnections
    )

    PerformanceConnections.DescendantAdded =
        Workspace.DescendantAdded:Connect(
            function(object)

                task.defer(function()

                    if object
                    and object.Parent then

                        ApplyPerformanceObject(object)
                    end
                end)
            end
        )

    PerformanceConnections.LightingAdded =
        Lighting.ChildAdded:Connect(
            function(object)

                task.defer(function()

                    ApplyNoCameraEffects()

                    if object then
                        ApplyRemoveLights(object)
                    end
                end)
            end
        )
end

--==================================================--
-- STRETCHER
--==================================================--

local StretchConnection = nil

-- CORREÇÃO DO SLIDER
local StretchDragging = false
local StretchDragInput = nil

local function StopStretchDragging()

    StretchDragging = false
    StretchDragInput = nil

end

local function DisconnectStretch()

    if StretchConnection then

        pcall(function()
            StretchConnection:Disconnect()
        end)

        StretchConnection = nil
    end
end

local function ApplyRealStretch()

    if not StretchEnabled then
        return
    end

    local Camera =
        Workspace.CurrentCamera

    if not Camera then
        return
    end

    local scale =
        math.clamp(
            StretchValue,
            CONFIG.StretchMin,
            CONFIG.StretchMax
        )

    pcall(function()

        Camera.CFrame =
            Camera.CFrame
            * CFrame.new(
                0,
                0,
                0,
                1, 0, 0,
                0, scale, 0,
                0, 0, 1
            )
    end)
end

local function SetStretchEnabled(enabled)

    StretchEnabled = enabled == true

    DisconnectStretch()

    if StretchEnabled then

        StretchConnection =
            RunService.RenderStepped:Connect(
                ApplyRealStretch
            )
    end

    SaveSettings()
end

local function SetStretchValue(value)

    local number = tonumber(value)

    if not number then
        return false
    end

    StretchValue =
        math.clamp(
            number,
            CONFIG.StretchMin,
            CONFIG.StretchMax
        )

    SaveSettings()

    return true
end

