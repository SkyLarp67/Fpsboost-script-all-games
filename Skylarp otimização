end

local function SetupPerformanceConnections()
    DisconnectList(PerformanceConnections)
    PerformanceConnections.DescendantAdded = Workspace.DescendantAdded:Connect(function(object)
        task.defer(function() if object and object.Parent then ApplyPerformanceObject(object) end end)
    end)
    PerformanceConnections.LightingAdded = Lighting.ChildAdded:Connect(function(object)
        task.defer(function()
            ApplyNoCameraEffects()
            if object then ApplyRemoveLights(object) end
        end)
    end)
end

