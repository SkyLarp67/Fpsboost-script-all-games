local function Create(
    className,
    properties,
    parent
)

    local object =
        Instance.new(className)

    for property, value in pairs(
        properties or {}
    ) do

        pcall(function()
            object[property] = value
        end)
    end

    if parent then
        object.Parent = parent
    end

    return object
end

local function AddCorner(object, radius)

    return Create(
        "UICorner",
        {
            CornerRadius =
                UDim.new(
                    0,
                    radius or 8
                )
        },
        object
    )
end

local function AddStroke(object, transparency)

    return Create(
        "UIStroke",
        {
            Thickness = 1,
            Transparency =
                transparency or 0.35
        },
        object
    )
end

