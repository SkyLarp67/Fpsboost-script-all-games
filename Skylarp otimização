local function CreateHDSlider(label, group, key, min, max, decimals)
    decimals = decimals or 2

    local row = Create(
        "Frame",
        {
            Size = UDim2.new(1, -20, 0, 50),
            BackgroundColor3 = Color3.fromRGB(28, 28, 34),
            BorderSizePixel = 0
        },
        HDList
    )
    AddCorner(row, 7)

    local title = Create("TextLabel", {
        Size = UDim2.new(1, -72, 0, 20),
        Position = UDim2.fromOffset(10, 4),
        BackgroundTransparency = 1,
        Text = label,
        TextColor3 = Color3.fromRGB(200, 200, 208),
        TextSize = 9,
        Font = Enum.Font.GothamMedium,
        TextXAlignment = Enum.TextXAlignment.Left
    }, row)

    local valueLabel = Create("TextLabel", {
        Size = UDim2.fromOffset(58, 20),
        Position = UDim2.new(1, -66, 0, 4),
        BackgroundTransparency = 1,
        TextColor3 = Color3.fromRGB(245, 245, 250),
        TextSize = 9,
        Font = Enum.Font.GothamBold,
        TextXAlignment = Enum.TextXAlignment.Right
    }, row)

    local track = Create("Frame", {
        Size = UDim2.new(1, -20, 0, 10),
        Position = UDim2.fromOffset(10, 32),
        BackgroundColor3 = Color3.fromRGB(48, 48, 56),
        BorderSizePixel = 0,
        Active = true
    }, row)
    AddCorner(track, 5)

    local fill = Create("Frame", {
        Size = UDim2.new(0, 0, 1, 0),
        Position = UDim2.fromScale(0, 0),
        BackgroundColor3 = Color3.fromRGB(105, 125, 220),
        BorderSizePixel = 0,
        Active = false
    }, track)
    AddCorner(fill, 5)

    local knob = Create("Frame", {
        Size = UDim2.fromOffset(18, 18),
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(0, 0, 0.5, 0),
        BackgroundColor3 = Color3.fromRGB(240, 240, 245),
        BorderSizePixel = 0,
        Active = false
    }, track)
    AddCorner(knob, 9)
    local stroke = AddStroke(knob, 0)
    stroke.Thickness = 2
    stroke.Color = Color3.fromRGB(20, 20, 24)

    local dragging = false
    local dragInput = nil

    local function formatValue(v)
        if decimals <= 0 then
            return tostring(math.floor(v + 0.5))
        end
        return string.format("%." .. tostring(decimals) .. "f", v)
    end

    local function refresh(value)
        local range = max - min
        local alpha = range > 0 and math.clamp((value - min) / range, 0, 1) or 0
        fill.Size = UDim2.new(alpha, 0, 1, 0)
        knob.Position = UDim2.new(alpha, 0, 0.5, 0)
        valueLabel.Text = formatValue(value)
    end

    local function setFromX(x, save)
        local left = track.AbsolutePosition.X
        local width = track.AbsoluteSize.X
        if width <= 0 then return end
        local alpha = math.clamp((x - left) / width, 0, 1)
        local value = min + (max - min) * alpha
        local step = 10 ^ decimals
        value = math.round(value * step) / step
        value = math.clamp(value, min, max)
        SHADER_CONFIG[group][key] = value
        refresh(value)
        if SHADER_CONFIG.Enabled then
            ApplyShaders()
        end
        if save then
            SaveSettings()
        end
    end

    local initial = ClampNumber(SHADER_CONFIG[group][key], min, max, min)
    SHADER_CONFIG[group][key] = initial
    refresh(initial)

    track.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch
        or input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            dragInput = input
            setFromX(input.Position.X, false)
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if not dragging then return end
        if input.UserInputType == Enum.UserInputType.MouseMovement
        or input == dragInput then
            setFromX(input.Position.X, false)
        end
    end)

    UserInputService.InputEnded:Connect(function(input)
        if dragInput and (input == dragInput
        or (dragInput.UserInputType == Enum.UserInputType.MouseButton1
        and input.UserInputType == Enum.UserInputType.MouseButton1)) then
            dragging = false
            dragInput = nil
            SaveSettings()
        end
    end)

    return row
end

